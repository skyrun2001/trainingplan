<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- No cleartext traffic to any host (matches usesCleartextTraffic="false" in manifest) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Production server: only trust system CAs -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">training.ginamarie-lukas.de</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
