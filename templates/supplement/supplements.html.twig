{% extends 'base.html.twig' %}

{% trans_default_domain 'supplements' %}

{% block title %}{{ 'supplements.page_title' | trans }} {{ app.user.username }}{% endblock %}

{% block body %}
<div class="container" style="max-width:900px;margin:0 auto;padding:24px 16px 60px">

  <div class="section-header" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px">
    <h1 class="section-title" style="margin:0">{{ 'supplements.page_title' | trans }}</h1>
    <button class="btn btn-primary" onclick="Suppl.openAddModal()">{{'button.add' |trans({}, 'messages')}}</button>
  </div>

  {# Low-stock alert banner #}
  <div id="lowStockBanner" class="low-stock-banner" style="display:none"></div>

  {# Cards grid #}
  <div class="suppl-grid" id="supplGrid">
    {% if supplements is empty %}
      <p class="empty-hint">{{ 'supplements.no_supplements' | trans }}</p>
    {% endif %}
  </div>

</div>

{# ── Add / Edit modal ─────────────────────────────────────────────────────── #}
<div class="modal-overlay" id="supplModal" style="display:none">
  <div class="modal" style="max-width:460px">
    <div class="modal-header">
      <span id="modalTitle">{{ 'supplements.add.add_supplement' | trans }}</span>
      <button class="modal-close" onclick="Suppl.closeModal()">✕</button>
    </div>
    <form id="supplForm" onsubmit="Suppl.saveForm(event)">
      <input type="hidden" id="supplId">

      <label for="fName" class="form-label">{{ 'supplements.add.name' | trans }}</label>
        <input class="form-input" id="fName" maxlength="100" required placeholder="{{ 'supplements.add.example_name' | trans }}">

      <label class="form-label">{{ 'supplements.add.when_to_take' | trans }}</label>
      <div class="timing-grid">
        <label class="timing-btn"><input type="checkbox" class="timing-check" value="morning">{{ 'supplements.add.morning' | trans }}</label>
        <label class="timing-btn"><input type="checkbox" class="timing-check" value="evening">{{ 'supplements.add.evening' | trans }}</label>
        <label class="timing-btn"><input type="checkbox" class="timing-check" value="pre_training">{{ 'supplements.add.pre_workout' | trans }}</label>
        <label class="timing-btn"><input type="checkbox" class="timing-check" value="post_training">{{ 'supplements.add.post_workout' | trans }}</label>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:4px">
        <div>
          <label for="fDosage" class="form-label">{{ 'supplements.add.dosage' | trans }}</label>
          <input class="form-input" id="fDosage" maxlength="50" placeholder="5 g">
        </div>
          <!----
        <div>
          <label for="fUnit" class="form-label">{{ 'supplements.add.unit_label' | trans }}</label>
          <input class="form-input" id="fUnit" maxlength="30" placeholder="{{ 'supplements.add.portions' | trans }}">
        </div>
        --->
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px">
        <div>
          <label for="fServingsPerDay" class="form-label">{{ 'supplements.add.servings_per_day' | trans }}</label>
          <input class="form-input" id="fServingsPerDay" type="number" min="1" max="99" value="1">
        </div>
        <div>
          <label for="fServingsRemaining" class="form-label">{{ 'supplements.add.remaining' | trans }}</label>
          <input class="form-input" id="fServingsRemaining" type="number" min="0" step="0.5" value="0">
        </div>
        <div>
          <label for="fTotalServings" class="form-label">{{ 'supplements.add.pack_size' | trans }}</label>
          <input class="form-input" id="fTotalServings" type="number" min="0" step="0.5" value="0">
        </div>
      </div>

      <label for="fWarningDays" class="form-label">{{ 'supplements.add.warning_when_label' | trans }}</label>
      <input class="form-input" id="fWarningDays" type="number" min="1" max="90" value="7">

      <label for="fNotes" class="form-label">{{ 'supplements.add.notes' | trans }}</label>
      <input class="form-input" id="fNotes" maxlength="255" placeholder="Optional">

      <div style="margin-top:20px;display:flex;gap:10px;justify-content:flex-end">
        <button type="button" class="btn btn-ghost" onclick="Suppl.closeModal()">{{'button.cancel' |trans({}, 'messages')}}</button>
        <button type="submit" class="btn btn-primary">{{'button.save' |trans({}, 'messages')}}</button>
      </div>
    </form>
  </div>
</div>

{# ── Restock modal ────────────────────────────────────────────────────────── #}
<div class="modal-overlay" id="restockModal" style="display:none">
  <div class="modal" style="max-width:360px">
    <div class="modal-header">
      <span>Restock — <span id="restockName"></span></span>
      <button class="modal-close" onclick="Suppl.closeRestock()">✕</button>
    </div>
    <label for="restockServings" class="form-label">{{ 'supplements.restock.package_size' | trans }} New pack size (servings)</label>
    <input class="form-input" id="restockServings" type="number" min="1" step="0.5" value="60">
    <p style="font-size:12px;color:var(--muted);margin-top:4px">{{ 'supplements.restock.package_size_subtitle' | trans }}</p>
    <div style="margin-top:20px;display:flex;gap:10px;justify-content:flex-end">
      <button class="btn btn-ghost" onclick="Suppl.closeRestock()">{{'button.cancel' |trans({}, 'messages')}}</button>
      <button class="btn btn-primary" onclick="Suppl.confirmRestock()">{{'button.save' |trans({}, 'messages')}}</button>
    </div>
  </div>
</div>

<script>
window.PAGE = window.PAGE || {};
window.PAGE.supplements = {{ supplementsJson|raw }};
</script>
{% endblock %}

{% block scripts %}
<script src="{{ asset('js/supplement.js') }}"></script>
{% endblock %}
