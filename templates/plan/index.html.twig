{% extends 'base.html.twig' %}
{% block title %}Trainingsplan{% endblock %}

{% block head %}
<style>
.tabs {
  display: flex;
  gap: 6px;
  padding: 16px 20px;
  overflow-x: auto;
  scrollbar-width: none;
  max-width: 680px;
  margin: 0 auto;
}
.tabs::-webkit-scrollbar { display: none; }
.tab {
  flex-shrink: 0;
  padding: 10px 16px;
  border-radius: 10px;
  border: 2px solid var(--border);
  background: var(--surface);
  color: var(--dim);
  font-family: inherit;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}
.tab.active {
  border-color: var(--accent);
  color: var(--accent);
  background: color-mix(in srgb, var(--accent) 10%, transparent);
}
.day { display: none; padding: 0 20px; max-width: 680px; margin: 0 auto; }
.day.active { display: block; }

.day-header {
  margin: 8px 0 20px;
  padding: 16px 18px;
  border-radius: 14px;
  background: color-mix(in srgb, var(--accent) 8%, transparent);
  border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}
.day-title { font-size: 20px; font-weight: 700; color: var(--accent); }
.day-focus { font-size: 13px; color: var(--dim); margin-top: 4px; }
.day-actions { display: flex; gap: 6px; flex-shrink: 0; }

.exercise {
  padding: 14px 0;
  border-bottom: 1px solid rgba(255,255,255,0.04);
  display: flex;
  align-items: flex-start;
  gap: 12px;
}
.ex-num {
  font-family: 'Space Mono', monospace;
  font-size: 12px;
  font-weight: 700;
  color: var(--accent);
  min-width: 24px;
  margin-top: 2px;
}
.ex-body { flex: 1; min-width: 0; }
.ex-name { font-size: 15px; font-weight: 600; line-height: 1.3; }
.ex-sets { font-size: 13px; color: var(--dim); margin-top: 4px; font-family: 'Space Mono', monospace; }
.ex-progression {
  display: inline-block;
  margin-top: 6px;
  padding: 3px 8px;
  font-size: 11px;
  border-radius: 6px;
  background: rgba(247,127,0,0.1);
  color: var(--warn);
  border: 1px solid rgba(247,127,0,0.2);
}
.ex-new {
  background: color-mix(in srgb, var(--accent) 10%, transparent);
  color: var(--accent);
  border-color: color-mix(in srgb, var(--accent) 25%, transparent);
}
.section-title {
  font-family: 'Space Mono', monospace;
  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--dim);
  margin: 24px 0 10px;
}
.note {
  margin-top: 20px;
  padding: 14px 16px;
  border-radius: 10px;
  background: var(--surface);
  border: 1px dashed rgba(255,255,255,0.1);
  font-size: 13px;
  color: var(--dim);
  line-height: 1.6;
}
.start-btn {
  padding: 8px 14px;
  border-radius: 9px;
  background: color-mix(in srgb, var(--accent) 15%, transparent);
  color: var(--accent);
  border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
  font-family: inherit;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  text-decoration: none;
  white-space: nowrap;
  transition: all 0.15s;
}
.start-btn:hover { background: color-mix(in srgb, var(--accent) 25%, transparent); }
.edit-plan-btn {
  padding: 8px 14px;
  border-radius: 9px;
  background: var(--surface2);
  color: var(--muted);
  border: 1px solid var(--border2);
  font-family: inherit;
  font-size: 12px;
  font-weight: 600;
  text-decoration: none;
  white-space: nowrap;
  transition: all 0.15s;
}
.edit-plan-btn:hover { color: var(--text); border-color: rgba(255,255,255,0.2); }
</style>
{% endblock %}

{% block body %}
<div class="tabs" id="tabs">
  {% for day in plan.days %}
    <button class="tab {% if loop.first %}active{% endif %}"
            data-day="{{ day.type }}"
            style="--accent:{{ day.color }}">
      {{ day.type|capitalize }}
    </button>
  {% endfor %}
</div>

{% for day in plan.days %}
  <div class="day {% if loop.first %}active{% endif %}"
       id="day-{{ day.type }}"
       style="--accent:{{ day.color }}">

    <div class="day-header">
      <div>
        <div class="day-title">{{ day.label }}</div>
        {% if day.focus %}<div class="day-focus">{{ day.focus }}</div>{% endif %}
      </div>
      <div class="day-actions">
        <a href="{{ path('app_plan_edit') }}#{{ day.type }}" class="edit-plan-btn">✎ Plan</a>
        <a href="{{ path('app_log', {type: day.type}) }}" class="start-btn">▶ Starten</a>
      </div>
    </div>

    {% set currentSection = '' %}
    {% for ex in day.exercises %}
      {% if ex.section != currentSection %}
        <div class="section-title">{{ ex.section }}</div>
        {% set currentSection = ex.section %}
      {% endif %}
      <div class="exercise">
        <div class="ex-num">{{ loop.index0 }}</div>
        <div class="ex-body">
          <div class="ex-name">{{ ex.name }}</div>
          <div class="ex-sets">
            {{ ex.defaultSets }} Sätze
            {% if ex.defaultReps %} · {{ ex.defaultReps }} Wdh{% endif %}
          </div>
          {% if ex.progressionNote %}
            <span class="ex-progression {% if ex.isNew %}ex-new{% endif %}">
              {{ ex.progressionNote }}
            </span>
          {% endif %}
        </div>
      </div>
    {% endfor %}

    {% if day.note %}
      <div class="note">{{ day.note }}</div>
    {% endif %}
  </div>
{% endfor %}
{% endblock %}

{% block scripts %}
<script src="/js/plan.js"></script>
{% endblock %}
