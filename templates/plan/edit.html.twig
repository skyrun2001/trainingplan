{% extends 'base.html.twig' %}
{% block title %}Plan bearbeiten{% endblock %}

{% block body %}
<div style="max-width:680px;margin:0 auto;padding:20px 20px 8px;display:flex;align-items:center;justify-content:space-between">
  <div>
    <div class="page-label">Plan bearbeiten</div>
    <div style="font-size:20px;font-weight:700">{{ plan.name }}</div>
  </div>
  <a href="{{ path('app_plan') }}" class="btn btn-ghost btn-sm">← Ansicht</a>
</div>

<div class="tabs" id="tabs">
  {% for day in plan.days %}
    <button class="tab {% if loop.first %}active{% endif %}"
            data-day="{{ day.type }}"
            data-day-id="{{ day.id }}"
            style="--accent:{{ day.color }}">
      {{ day.type|capitalize }}
    </button>
  {% endfor %}
  <button class="tab" id="addDayTab" onclick="toggleAddDayForm()" style="--accent:#888;border-style:dashed">+ Tag</button>
</div>

{# Add day form — hidden by default #}
<div id="addDayForm" style="display:none;max-width:680px;margin:0 auto 16px;padding:0 20px">
  <div class="add-exercise-area">
    <div class="add-exercise-title"><span>+</span> Neuen Trainingstag hinzufügen</div>
    <div class="form-grid">
      <div>
        <label class="f-label">Bezeichnung *</label>
        <input class="f-input" id="new-day-label" placeholder="z.B. Push — Brust, Schulter, Trizeps">
      </div>
      <div>
        <label class="f-label">Kürzel (für Tab) *</label>
        <input class="f-input" id="new-day-type" placeholder="z.B. push2" maxlength="20">
      </div>
      <div>
        <label class="f-label">Farbe</label>
        <div style="display:flex;gap:6px;flex-wrap:wrap;padding-top:4px" id="colorPicker">
          {% for color in ['#C9184A','#2D6A4F','#E09F3E','#4361EE','#7B2D8B','#0891B2','#16A34A','#EA580C'] %}
            <button type="button"
                    onclick="selectColor('{{ color }}')"
                    data-color="{{ color }}"
                    style="width:28px;height:28px;border-radius:7px;background:{{ color }};border:2px solid transparent;cursor:pointer;transition:border-color 0.15s"
                    title="{{ color }}"></button>
          {% endfor %}
        </div>
        <input type="hidden" id="new-day-color" value="#C9184A">
      </div>
      <div>
        <label class="f-label">Fokus / Untertitel</label>
        <input class="f-input" id="new-day-focus" placeholder="z.B. Schwerer Tag · ~60 Min">
      </div>
    </div>
    <div class="form-actions" style="justify-content:flex-start;margin-top:4px">
      <button class="btn btn-ghost btn-sm" onclick="toggleAddDayForm()">Abbrechen</button>
      <button class="btn btn-primary btn-sm" onclick="addDay()">Tag hinzufügen</button>
    </div>
  </div>
</div>

{% for day in plan.days %}
  <div class="day-edit {% if loop.first %}active{% endif %}"
       id="day-{{ day.type }}"
       style="--accent:{{ day.color }}">

    {# Day header — click to edit day props #}
    <div class="edit-day-header">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:8px">
        <div class="edit-day-title" onclick="toggleDayForm({{ day.id }})">
          <span>{{ day.label }}</span>
          <span style="font-size:12px;font-weight:400;color:var(--dim)">✎ bearbeiten</span>
        </div>
        <button class="icon-btn danger" title="Tag löschen" onclick="deleteDay({{ day.id }}, '{{ day.label|e('js') }}')">✕</button>
      </div>
      {% if day.focus %}<div style="font-size:12px;color:var(--dim);margin-top:4px">{{ day.focus }}</div>{% endif %}

      <div class="edit-day-form" id="day-form-{{ day.id }}">
        <div class="form-grid">
          <div>
            <label class="f-label">Bezeichnung</label>
            <input class="f-input" id="day-label-{{ day.id }}" value="{{ day.label }}">
          </div>
          <div>
            <label class="f-label">Fokus / Untertitel</label>
            <input class="f-input" id="day-focus-{{ day.id }}" value="{{ day.focus ?? '' }}">
          </div>
          <div class="form-full">
            <label class="f-label">Notiz</label>
            <input class="f-input" id="day-note-{{ day.id }}" value="{{ day.note ?? '' }}" placeholder="z.B. 💡 Hinweis...">
          </div>
        </div>
        <div class="form-actions">
          <button class="btn btn-ghost btn-sm" onclick="toggleDayForm({{ day.id }})">Abbrechen</button>
          <button class="btn btn-primary btn-sm" onclick="saveDayForm({{ day.id }})">Speichern</button>
        </div>
      </div>
    </div>

    {# Exercise list #}
    <div id="ex-list-{{ day.id }}">
      {% set currentSection = '' %}
      {% for ex in day.exercises %}
        {% if ex.section != currentSection %}
          <div class="section-sep">{{ ex.section }}</div>
          {% set currentSection = ex.section %}
        {% endif %}

        <div id="ex-item-{{ ex.id }}">
          <div class="ex-edit-row">
            <span class="ex-edit-num">{{ loop.index0 }}</span>
            <div class="ex-edit-info">
              <div class="ex-edit-name">{{ ex.name }}</div>
              <div class="ex-edit-meta">
                {{ ex.defaultSets }}× {% if ex.defaultReps %}{{ ex.defaultReps }} Wdh{% else %}—{% endif %}
                · {{ ex.section }}
              </div>
              {% if ex.progressionNote %}
                <span class="prog-badge {% if ex.isNew %}is-new{% endif %}">{{ ex.progressionNote }}</span>
              {% endif %}
            </div>
            <div class="ex-edit-actions">
              <button class="icon-btn" title="Nach oben" onclick="moveEx({{ ex.id }}, 'up')">↑</button>
              <button class="icon-btn" title="Nach unten" onclick="moveEx({{ ex.id }}, 'down')">↓</button>
              <button class="icon-btn" title="Bearbeiten" onclick="toggleExForm({{ ex.id }})">✎</button>
              <button class="icon-btn danger" title="Löschen" onclick="deleteEx({{ ex.id }})">✕</button>
            </div>
          </div>

          <div class="ex-inline-form" id="ex-form-{{ ex.id }}">
            <div class="form-grid form-grid-3">
              <div class="form-full">
                <label class="f-label">Übungsname</label>
                <input class="f-input" id="ex-name-{{ ex.id }}" value="{{ ex.name }}">
              </div>
              <div>
                <label class="f-label">Abschnitt</label>
                <input class="f-input" id="ex-section-{{ ex.id }}" value="{{ ex.section }}"
                       list="sections-{{ day.id }}">
              </div>
              <div>
                <label class="f-label">Std. Sätze</label>
                <input class="f-input" type="number" id="ex-sets-{{ ex.id }}" value="{{ ex.defaultSets }}" min="1" max="10">
              </div>
              <div>
                <label class="f-label">Std. Wdh</label>
                <input class="f-input" type="number" id="ex-reps-{{ ex.id }}" value="{{ ex.defaultReps ?? '' }}" placeholder="—" min="1" max="99">
              </div>
              <div class="form-full">
                <label class="f-label">Progression / Badge-Text</label>
                <input class="f-input" id="ex-prog-{{ ex.id }}" value="{{ ex.progressionNote ?? '' }}" placeholder="z.B. ↑ steigern auf 70 kg">
              </div>
              <div>
                <label class="f-label">&nbsp;</label>
                <div class="checkbox-row">
                  <input type="checkbox" id="ex-new-{{ ex.id }}" {% if ex.isNew %}checked{% endif %}>
                  <label for="ex-new-{{ ex.id }}">Als NEU markieren</label>
                </div>
              </div>
            </div>
            <div class="form-actions">
              <button class="btn btn-ghost btn-sm" onclick="toggleExForm({{ ex.id }})">Abbrechen</button>
              <button class="btn btn-primary btn-sm" onclick="saveEx({{ ex.id }})">Speichern</button>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    {# Autocomplete sections datalist #}
    <datalist id="sections-{{ day.id }}">
      {% set seenSections = [] %}
      {% for ex in day.exercises %}
        {% if ex.section not in seenSections %}
          <option value="{{ ex.section }}">
          {% set seenSections = seenSections|merge([ex.section]) %}
        {% endif %}
      {% endfor %}
    </datalist>

    {# Add new exercise #}
    <div class="add-exercise-area">
      <div class="add-exercise-title"><span>+</span> Neue Übung hinzufügen</div>
      <div class="form-grid form-grid-3">
        <div class="form-full">
          <label class="f-label">Übungsname *</label>
          <input class="f-input" id="new-name-{{ day.id }}" placeholder="z.B. Bankdrücken">
        </div>
        <div>
          <label class="f-label">Abschnitt</label>
          <input class="f-input" id="new-section-{{ day.id }}" value="Hauptteil"
                 list="sections-{{ day.id }}">
        </div>
        <div>
          <label class="f-label">Sätze</label>
          <input class="f-input" type="number" id="new-sets-{{ day.id }}" value="3" min="1" max="10">
        </div>
        <div>
          <label class="f-label">Wdh</label>
          <input class="f-input" type="number" id="new-reps-{{ day.id }}" placeholder="—" min="1" max="99">
        </div>
        <div class="form-full">
          <label class="f-label">Progression (optional)</label>
          <input class="f-input" id="new-prog-{{ day.id }}" placeholder="z.B. ↑ steigern auf 70 kg">
        </div>
      </div>
      <div class="form-actions" style="justify-content:flex-start">
        <button class="btn btn-primary btn-sm" onclick="addExercise({{ day.id }})">Übung hinzufügen</button>
      </div>
    </div>
  </div>
{% endfor %}
{% endblock %}

{% block scripts %}
<script src="/js/plan-edit.js"></script>
{% endblock %}
