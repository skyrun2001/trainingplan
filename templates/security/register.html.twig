{% extends 'base.html.twig' %}
{% block title %}Registrieren{% endblock %}

{% block head %}

{% endblock %}

{% trans_default_domain 'auth' %}

{% block body %}
<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-title">{{ 'auth.register.title'|trans }}</div>
    <div class="auth-sub">Dein persönlicher Trainingsplan</div>

    {% if error %}
      <div class="auth-error">{{ error }}</div>
    {% endif %}

    <form method="post">
      <div class="field">
        <label for="username">{{ 'auth.register.username'|trans }}</label>
        <input type="text" id="username" name="username"
               value="{{ app.request.request.get('username') }}"
               autocomplete="username" autofocus required
               pattern="[a-zA-Z0-9_\-\.]+" minlength="3">
        <div class="hint">Buchstaben, Zahlen, _ - . · mind. 3 Zeichen</div>
      </div>
      <div class="field">
        <label for="password">{{ 'auth.register.password'|trans }}</label>
        <input type="password" id="password" name="password"
               autocomplete="new-password" required minlength="6">
        <div class="hint">Mind. 6 Zeichen</div>
      </div>
      <div class="field">
        <label for="confirm">Passwort wiederholen</label>
        <input type="password" id="confirm" name="confirm"
               autocomplete="new-password" required>
      </div>
      <button class="auth-btn" type="submit">{{ 'auth.register.submit'|trans }}</button>
    </form>

    <div class="auth-footer">
      {{ 'auth.register.back'|trans }} <a href="{{ path('app_login') }}">{{ 'auth.login.submit'|trans }}</a>
    </div>
  </div>
</div>
{% endblock %}
