{% extends 'base.html.twig' %}
{% block title %}Login{% endblock %}

{% block head %}
{% endblock %}

{% trans_default_domain 'auth' %}

{% block body %}
<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-title">{{ 'auth.login.title'|trans }}</div>
    <div class="auth-sub">{{ 'auth.login.subtitle'|trans }}</div>

    {% if error %}
      <div class="auth-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    {% if app.request.query.get('registered') %}
      <div style="background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.3);border-radius:9px;color:var(--green);font-size:13px;padding:10px 14px;margin-bottom:16px">
        {{ 'auth.registered'|trans }}
      </div>
    {% endif %}

    <form method="post">
      <div class="field">
        <label for="username">{{ 'auth.login.username'|trans }}</label>
        <input type="text" id="username" name="username"
               value="{{ last_username }}" autocomplete="username" autofocus required>
      </div>
      <div class="field">
        <label for="password">{{ 'auth.login.password'|trans }}</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required>
      </div>
      <div class="remember-row">
        <input type="checkbox" id="remember" name="_remember_me">
        <label for="remember">{{ 'auth.login.remember'|trans }}</label>
      </div>
      <button class="auth-btn" type="submit">{{ 'auth.login.submit'|trans }}</button>
    </form>

  </div>
</div>
{% endblock %}
