{% extends 'base.html.twig' %}
{% trans_default_domain 'logging' %}

{% block title %}{{"logging.page_title" | trans}} {{ type|upper }}{% endblock %}

{% block head %}
<style>
{% set colors = {'push':'#C9184A','pull':'#2D6A4F','legs':'#E09F3E','upper':'#4361EE'} %}
{% set accent = colors[type] ?? '#888' %}
:root { --accent: {{ accent }}; }
</style>
{% endblock %}



{% block body %}
<div class="type-selector">
  {% for t, label in {'push':'Push','pull':'Pull','legs':'Beine','upper':'Upper'} %}
    <a href="{{ path('app_log', {type: t}) }}" class="type-btn {% if type == t %}active{% endif %}">{{ label }}</a>
  {% endfor %}
</div>

<div class="page">
  <div class="log-header">
    <div class="page-label">Training loggen</div>
    <div class="page-title" style="color: var(--accent)">
      {% set labels = {'push':'Push — Brust, Schulter, Trizeps','pull':'Pull — Rücken, Bizeps','legs':'Beine — Komplett','upper':'Upper — Schwachpunkte'} %}
      {{ labels[type] }}
    </div>
    <div class="progress-bar-wrap" style="margin-top:12px">
      <div class="progress-bar-fill" id="progressBar" style="width:0"></div>
    </div>
  </div>

  <div id="exerciseList">
    {% for ex in exercises %}
      {% if loop.first or ex.section != exercises[loop.index0 - 1].section %}
        <div class="section-sep">{{ ex.section }}</div>
      {% endif %}

      <div class="exercise-card" data-name="{{ ex.name }}">
        <div class="ex-header" onclick="toggleSets(this)">
          <span class="ex-num-badge">{{ loop.index0 }}</span>
          <div>
            <div class="ex-title">{{ ex.name }}</div>
            <div class="ex-summary" id="summary-{{ loop.index0 }}">{{ ex.defaultSets }} {{"trainings.set" | trans({}, "messages")}} · {{ ex.defaultReps ?? '—' }} {{"unit.repetitions_abbr" | trans({}, "messages")}}</div>
          </div>
          <span class="ex-chevron" id="chevron-{{ loop.index0 }}">▼</span>
        </div>
        <div class="sets-container" id="sets-{{ loop.index0 }}">
          <div class="prev-hint" id="prev-{{ loop.index0 }}">{{"logging.last_session" | trans}} <span>{{"logging.loading" | trans}}</span></div>
          <div class="col-headers">
            <div class="col-header"></div>
            <div class="col-header">Wdh</div>
            <div class="col-header">kg</div>
            <div class="col-header rpe-header">
              RPE <span class="rpe-info-icon">ⓘ</span>
              <div class="rpe-tooltip">
                <strong>{{"logging.rpe_headline" | trans}} </strong><br>
                  {{"logging.rpe_subtitle" | trans}} <br><br>
                <span style="color:#4CAF7D">6</span>{{"logging.rpe_explanation.four_plus" | trans}} <br>
                <span style="color:#4CAF7D">7</span>{{"logging.rpe_explanation.three" | trans}} <br>
                <span style="color:#E0A03E">8</span>{{"logging.rpe_explanation.two" | trans}}<br>
                <span style="color:#E0A03E">9</span>{{"logging.rpe_explanation.one" | trans}} <br>
                <span style="color:#C9184A">10</span>{{"logging.rpe_explanation.zero" | trans}}
              </div>
            </div>
            <div></div>
          </div>
          <div class="set-rows" id="rows-{{ loop.index0 }}">
            {% for i in 1..ex.defaultSets %}
              <div class="set-row">
                <span class="set-label">{{ i }}</span>
                  <label>
                      <input type="number" class="set-input reps-input" placeholder={{"unit.rep" | trans({}, "messages")}} min="1" max="99"
                             value="{{ ex.defaultReps ?? '' }}" data-set="{{ i }}" oninput="updateSummary({{ loop.parent.loop.index0 }})">
                  </label>
                  <label>
                      <input type="number" class="set-input weight-input" placeholder={{"unit.kg" | trans({}, "messages")}} min="0" max="999" step="0.5"
                           data-set="{{ i }}" oninput="onWeightInput(this); updateSummary({{ loop.parent.loop.index0 }})">
                  </label>
                  <label>
                      <select class="set-input rpe-input" data-set="{{ i }}" onchange="onRpeChange(this)">
                      <option value="">—</option>
                      <option value="6">{{"logging.rpe_options.easy" | trans}}</option>
                      <option value="7">{{"logging.rpe_options.moderate" | trans}}</option>
                      <option value="8">{{"logging.rpe_options.heavy" | trans}}</option>
                      <option value="9">{{"logging.rpe_options.extrem_heavy" | trans}}</option>
                      <option value="10">{{"logging.rpe_options.max" | trans}}</option>
                    </select>
                  </label>
                  <button class="remove-set" onclick="removeSet(this)" title={{"button.delete_set" |trans({}, "messages")}}>×</button>
              </div>
            {% endfor %}
          </div>
          <button class="add-set-btn" onclick="addSet({{ loop.index0 }})">{{"button.add_set" |trans({}, "messages")}}</button>
        </div>
      </div>
    {% endfor %}
  </div>

  <hr class="divider" style="margin-top:20px">
  <div class="section-sep">{{"logging.detail" | trans}}</div>
  <div class="meta-row">
    <div class="meta-field">
      <label for="metaDate">{{"overall.date" |trans({}, "messages")}}</label>
      <input type="date" id="metaDate" value="{{ "now"|date("Y-m-d") }}">
    </div>
    <div class="meta-field">
      <label for="metaDuration">{{"overall.duration" |trans({}, "messages")}} ({{"unit.min" |trans({}, "messages")}})</label>
      <input type="number" id="metaDuration" placeholder="z.B. 60" min="10" max="180">
    </div>
  </div>
  <div class="meta-field">
    <label for="metaNotes">{{"logging.notes" |trans}}</label>
    <textarea id="metaNotes" placeholder= {{"logging.notes_description" |trans}}></textarea>
  </div>
  <div style="height:80px"></div>
</div>

<div class="submit-bar">
  <a href="{{ path('app_plan') }}" class="btn btn-ghost">{{"button.back" |trans({}, "messages")}}</a>
  <button class="btn btn-primary" id="saveBtn" onclick="saveWorkout()">{{"button.save" |trans({}, "messages")}}</button>
</div>
{% endblock %}

{% block scripts %}
<script>
window.PAGE = {
  type:      {{ type|json_encode }},
  exercises: {{ exercisesJson|raw }},
};
</script>
<script src="{{ asset('js/log.js') }}"></script>
{% endblock %}
