{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block head %}<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
{% endblock %}

{% trans_default_domain 'dashboard' %}

{% block body %}
<div class="page">
  <div class="page-header">
    <div class="page-label"> {{ "dashboard.page_label"|trans }}</div>
    <div class="page-title">{{ "dashboard.page_headline"|trans }}</div>
    <div class="page-sub">{{ app.user.username }} {{ "dashboard.goal"|trans }}</div>
  </div>

  {% if totalSessions == 0 %}
    <div class="empty-state">
      <div style="font-size:48px;margin-bottom:12px">🏋️</div>
      <div style="font-size:16px;font-weight:600;color:var(--text);margin-bottom:6px">{{ "dashboard.empty_trainings_message"|trans }}</div>
      <div style="margin-bottom:20px">{{ "dashboard.call_to_cation_first_training"|trans }}</div>
      <a href="{{ path('app_log') }}" class="btn btn-primary">{{ "dashboard.start_training"|trans }}</a>
    </div>
  {% else %}

  {# ── KPIs ── #}
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-value" style="color:#22c55e">{{ streak }}</div>
      <div class="stat-label">Streak</div><div class="stat-sub">{{ "dashboard.days_in_row"|trans }}</div>
    </div>
    <div class="stat-card">
      <div class="stat-value">{{ totalSessions }}</div>
      <div class="stat-label">Total</div><div class="stat-sub">{{ "overall.trainings"|trans }}</div>
    </div>
    <div class="stat-card">
      <div class="stat-value" style="color:var(--legs)">{{ weeklyData|map(w => w.count)|reduce((a,b) => a+b, 0) }}</div>
      <div class="stat-label">4 Wochen</div><div class="stat-sub">{{ "overall.trainings"|trans }}</div>
    </div>
    <div class="stat-card">
      <div class="stat-value" style="color:var(--upper)">{{ sessions|first ? sessions|first.date|date('d.m') : '—' }}</div>
      <div class="stat-label">Letztes</div><div class="stat-sub">{{ "overall.training"|trans }}</div>
    </div>
  </div>
  {% endif %}

  {# ── Weekly plan ── #}
  <div class="card">
    <div class="card-title" style="display:flex;justify-content:space-between;align-items:center">
      <span>Diese Woche</span>
      <button class="btn btn-ghost btn-sm" id="schedEditBtn" onclick="toggleScheduleEditor()">{{ "button.edit"|trans({}, 'messages')  }}</button>
    </div>

    <div class="week-grid" id="weekGrid">
      {% for day in weekDays %}
        {% set stateClass = '' %}
        {% if day.hasSessions %}
          {% set stateClass = 'is-done' %}
        {% elseif day.isToday %}
          {% set stateClass = 'is-today' %}
        {% elseif day.isPast and day.scheduledType %}
          {% set stateClass = 'is-missed' %}
        {% endif %}

        <div class="week-day {{ stateClass }}">
          <div class="wd-label">{{ day.label }}</div>
          <div class="wd-num">{{ day.dayNum }}</div>
          {% if day.scheduledType %}
            <div class="wd-type t-{{ day.scheduledType }}">{{ day.scheduledType|upper }}</div>
          {% else %}
            <div class="wd-type t-rest">—</div>
          {% endif %}
          <div class="wd-status">
            {% if day.hasSessions %}
              <span style="color:var(--green)">✓</span>
            {% elseif day.isToday and day.scheduledType %}
              🎯
            {% elseif day.isToday %}
              ●
            {% elseif day.isPast and day.scheduledType %}
              <span style="color:var(--push)">✗</span>
            {% elseif day.scheduledType %}
              <span style="color:var(--muted)">○</span>
            {% else %}
              <span style="color:var(--muted)">—</span>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    {# Schedule editor #}
    <div class="sched-editor" id="schedEditor">
      {% set typeOptions = {'': '—', 'push': 'PUSH', 'pull': 'PULL', 'legs': 'BEIN', 'upper': 'UPPR'} %}
      {% for day in weekDays %}
        <div class="sched-col">
          <label for="sched-date">{{ day.label }}</label>
          <select class="sched-select" data-weekday="{{ day.isoWeekday }}" onchange="saveSchedule()" id="sched-date">
            {% for val, lbl in typeOptions %}
              <option value="{{ val }}" {% if schedule[day.isoWeekday] == val %}selected{% endif %}>{{ lbl }}</option>
            {% endfor %}
          </select>
        </div>
      {% endfor %}
    </div>

    {# Reminder #}
    <div class="reminder-row">
      <label for="reminderTime"> {{ "dashboard.reminder"|trans }}</label>
      <input type="time" class="reminder-time-input" id="reminderTime"
             value="{{ reminderTime ?? '' }}"
             onchange="saveReminderTime(this.value)">
      <span class="notif-badge" id="notifBadge">{{ "dashboard.give_permission_to_remind"|trans }}</span>
      <button class="btn btn-ghost btn-sm" onclick="requestNotifPermission()">{{ "button.allow"|trans({}, 'messages')  }}</button>
      <span style="font-size:11px;color:var(--muted)">{{ "dashboard.reminder_sub_information"|trans }}</span>
    </div>
  </div>

  {# ── Health data ── #}
  <div class="card">
    <div class="card-title" style="display:flex;justify-content:space-between;align-items:center">
      <span>Gesundheit</span>
      <div style="display:flex;gap:8px;align-items:center">
        <span style="font-size:11px;color:var(--muted)">{{ "now"|date('d.m.Y') }}</span>
        <button class="btn btn-ghost btn-sm" id="healthEditBtn" onclick="toggleHealthEdit()">✎</button>
      </div>
    </div>

    {# — Edit panel (hidden by default) — #}
    <div id="healthEditPanel" style="display:none;padding-bottom:12px;border-bottom:1px solid var(--border);margin-bottom:12px">
      <div class="health-edit-section">
        <div class="health-edit-label">{{ "dashboard.show_cards"|trans }}</div>
        <div class="edit-chips" id="cardChips"></div>
      </div>
      <div class="health-edit-section">
        <div class="health-edit-label">{{ "dashboard.diagramms"|trans }}</div>
        <div class="edit-chips" id="chartChips"></div>
      </div>
      <div class="health-edit-section">
        <div class="health-edit-label">{{ "dashboard.time_span"|trans }}</div>
        <div class="day-btns">
          <button class="day-btn" data-days="7"  onclick="setChartDays(7,this)">{{ "diagrams.days.seven_days"|trans({}, 'messages')  }}</button>
          <button class="day-btn" data-days="14" onclick="setChartDays(14,this)">{{ "diagrams.days.fourteen_days"|trans({}, 'messages')  }}</button>
          <button class="day-btn" data-days="30" onclick="setChartDays(30,this)">{{ "diagrams.days.thirty_days"|trans({}, 'messages')  }}</button>
          <button class="day-btn" data-days="60" onclick="setChartDays(60,this)">{{ "diagrams.days.sixty_days"|trans({}, 'messages')  }}</button>
          <button class="day-btn" data-days="90" onclick="setChartDays(90,this)">{{ "diagrams.days.ninety_days"|trans({}, 'messages')  }}</button>
        </div>
      </div>
      <button class="btn btn-primary btn-sm" onclick="saveHealthConfig()" style="margin-top:4px">{{ "button.save"|trans({}, 'messages')  }}</button>
    </div>

    {# — Metric cards (populated by JS) — #}
    <div class="health-metrics-grid" id="healthMetricsGrid"></div>

    {# — Charts (populated by JS) — #}
    <div id="healthChartsContainer" style="margin-top:12px"></div>

    {# — Manual entry form — #}
    {% set _mm = {
      steps:              {icon: '👣', label: "overall.steps"|trans({}, 'messages')  ,     step: '1',   unit: ''},
      sleep_minutes:      {icon: '💤', label:  "overall.sleep"|trans({}, 'messages')  , step: '1',   unit:  "unit.min"|trans({}, 'messages')  },
      active_minutes:     {icon: '🏃', label:  "overall.active_time"|trans({}, 'messages')  ,   step: '1',   unit: "unit.min"|trans({}, 'messages')  },
      weight_kg:          {icon: '⚖️', label:  "overall.weight"|trans({}, 'messages')  ,     step: '0.1', unit: 'unit.kg'|trans({}, 'messages')  },
      calories_kcal:      {icon: '🔥', label:  "overall.calories"|trans({}, 'messages')  ,    step: '1',   unit: "unit.kcal"|trans({}, 'messages') },
      heart_rate_avg:     {icon: '❤️', label:  "overall.heart_rate_avg"|trans({}, 'messages')  ,  step: '1',   unit: "unit.bpm"|trans({}, 'messages')  },
      heart_rate_resting: {icon: '💗', label:  "overall.pulse"|trans({}, 'messages')  ,    step: '1',   unit: "unit.bpm"|trans({}, 'messages')  },
      distance_meters:    {icon: '📍', label:  "overall.distance"|trans({}, 'messages')  ,     step: '1',   unit: "unit.meter"|trans({}, 'messages')  },
      vo2_max:            {icon: '💨', label:  "overall.vo2_max"|trans({}, 'messages')  ,     step: '0.1', unit: ''},
    } %}
    {% set _cardKeys  = healthDashboard.cards|map(c => c.metric) %}
    {% set _chartKeys = healthDashboard.chartMetrics ?? [] %}
    {% set _entryKeys = [] %}
    {% set _seen      = [] %}
    {% for _k in _cardKeys|merge(_chartKeys) %}
      {% if _k not in _seen %}
        {% set _entryKeys = _entryKeys|merge([_k]) %}
        {% set _seen      = _seen|merge([_k]) %}
      {% endif %}
    {% endfor %}
    {% if _entryKeys is empty %}
      {% set _entryKeys = ['steps', 'weight_kg', 'calories_kcal', 'sleep_minutes', 'active_minutes'] %}
    {% endif %}

    <div class="health-entry-toggle" onclick="toggleHealthForm()" id="healthToggle">
      <span>✎{{ "button.track_data"|trans({}, 'messages')  }}</span>
      <span id="healthToggleArrow">▼</span>
    </div>
    <div class="health-entry-form" id="healthForm">
      <div class="health-input-group" style="margin-bottom:8px">
        <label for="healthDate">Datum</label>
        <input type="date" class="health-input" id="healthDate"
               value="{{ "now"|date('Y-m-d') }}" max="{{ "now"|date('Y-m-d') }}">
      </div>
      <div class="health-entry-fields" id="healthEntryFields">
        {% for _k in _entryKeys %}
          {% set _d   = _mm[_k] ?? {icon: '📊', label: _k|replace({'_': ' '})|title, step: 'any', unit: ''} %}
          {% set _cur = todayMetrics[_k] ?? '' %}
          <div class="health-input-group">
            <label>{{ _d.icon }} {{ _d.label }}{% if _d.unit %} <span style="color:var(--muted);font-size:9px">{{ _d.unit }}</span>{% endif %}</label>
            <input type="number" class="health-input health-entry-input"
                   data-metric="{{ _k }}"
                   placeholder="--"
                   value="{{ _cur != '' ? _cur : '' }}"
                   step="{{ _d.step }}"
                   min="0">
          </div>
        {% endfor %}
      </div>
      <div style="display:flex;gap:8px;align-items:center;margin-top:8px">
        <button class="btn btn-primary btn-sm" onclick="saveHealthEntry()" id="healthSaveBtn">{{ "button.save"|trans({}, 'messages')  }}</button>
        <span id="healthSaveMsg" style="font-size:12px;color:var(--green);display:none">{{ "button.saved"|trans({}, 'messages')  }}</span>
      </div>
    </div>

    <div class="health-meta">
      <span class="health-dot"></span>
        {{ "dashboard.sync_information"|trans }}
    </div>
  </div>

  {% if totalSessions > 0 %}
  {# ── Split distribution ── #}
  <div class="card">
    <div class="card-title">Split-Verteilung</div>
    <div class="type-stats">
      {% for key, cfg in {'push':{'label':'Push','color':'var(--push)'},'pull':{'label':'Pull','color':'#4CAF7D'},'legs':{'label':'Beine','color':'var(--legs)'},'upper':{'label':'Upper','color':'#7B9EFF'}} %}
        <div class="type-stat tag-{{ key }}">
          <div class="type-stat-val" style="color:{{ cfg.color }}">{{ typeMap[key] ?? 0 }}</div>
          <div class="type-stat-lbl">{{ cfg.label }}</div>
        </div>
      {% endfor %}
    </div>
  </div>

  {# ── 4-week bars ── #}
  <div class="card">
    <div class="card-title">Letzte 4 Wochen</div>
    {% set maxCount = max(weeklyData|map(w => w.count)) %}
    <div class="week-bars">
      {% for week in weeklyData %}
        {% set heightPct = maxCount > 0 ? (week.count / maxCount * 100)|round : 0 %}
        <div class="week-bar-wrap">
          <div class="week-count">{{ week.count }}</div>
          <div class="week-bar {% if week.count > 0 %}has-data{% endif %}"
               style="height:{{ max(heightPct, 10) }}%"></div>
          <div class="week-label">{{ week.label }}</div>
        </div>
      {% endfor %}
    </div>
  </div>

  {# ── Progression chart ── #}
  {% if exerciseNames is not empty %}
  <div class="card">
    <div class="card-title">Progression</div>
    <select class="exercise-select" id="exerciseSelect" onchange="loadChart(this.value)">
      <option value="">— Übung wählen —</option>
      {% for name in exerciseNames %}
        <option value="{{ name }}">{{ name }}</option>
      {% endfor %}
    </select>
    <div class="chart-container"><canvas id="progressionChart"></canvas></div>
    <div id="chartEmpty" style="text-align:center;color:var(--muted);font-size:13px;padding:30px 0;display:none">
      Noch keine Daten für diese Übung.
    </div>
  </div>
  {% endif %}

  {# ── Personal bests ── #}
  {% if personalBests is not empty %}
  <div class="card">
    <div class="card-title">{{ "dashboard.personal_bests"|trans }}</div>
    {% for pb in personalBests %}
      {% if pb.maxWeight is not null %}
      <div class="pb-row">
        <div class="pb-name">{{ pb.exerciseName }}</div>
        <div class="pb-vals"><span>{{ pb.maxWeight }} kg</span><span style="color:var(--dim)">×{{ pb.maxReps }}</span></div>
      </div>
      {% endif %}
    {% endfor %}
  </div>
  {% endif %}

  {# ── History ── #}
  <div class="card">
    <div class="card-title" style="display:flex;justify-content:space-between;align-items:center">
      <span>Trainingshistorie</span>
      <a href="{{ path('app_log') }}" class="btn btn-ghost btn-sm">+ Neu</a>
    </div>
    {% for session in sessions %}
      <div class="session-item" id="session-{{ session.id }}">
        <div class="session-dot" style="background:{{ session.typeColor }}"></div>
        <div class="session-body">
          <div class="session-title">{{ session.typeLabel }}</div>
          <div class="session-meta">
            {{ session.date|date('d.m.Y') }}
            {% if session.durationMinutes %} · {{ session.durationMinutes }} Min{% endif %}
            · {{ session.exerciseLogs|length }} Sätze
          </div>
          {% if session.exerciseLogs is not empty %}
            <div class="session-exercises">
              {% set seen = [] %}
              {% for log in session.exerciseLogs %}
                {% if log.exerciseName not in seen %}
                  {% set seen = seen|merge([log.exerciseName]) %}
                  <span class="ex-pill">{{ log.exerciseName }}</span>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
          {% if session.notes %}
            <div style="font-size:12px;color:var(--muted);margin-top:6px;font-style:italic">{{ session.notes }}</div>
          {% endif %}
        </div>
        <button class="btn btn-danger btn-sm" onclick="deleteSession({{ session.id }})">✕</button>
      </div>
    {% endfor %}
  </div>
  {% endif %}
</div>
{% endblock %}

{% block scripts %}
{% set _today = weekDays|filter(d => d.isToday)|first|default(null) %}
<script>
window.PAGE = {
  todayMetrics:       {{ todayMetrics|json_encode|raw }},
  availableKeys:      {{ availableKeys|json_encode|raw }},
  healthDashboard:    {{ healthDashboard|json_encode|raw }},
  healthChartJson:    {{ healthChartJson|raw }},
  todayScheduledType: {{ (_today ? _today.scheduledType|default('') : '')|json_encode }},
  todayHasSessions:   {{ (_today and _today.hasSessions) ? 'true' : 'false' }},
  metricLabels: {{ {
    steps:              'overall.steps'|trans({}, 'messages'),
    sleep_minutes:      'overall.sleep'|trans({}, 'messages'),
    active_minutes:     'overall.active_time'|trans({}, 'messages'),
    weight_kg:          'overall.weight'|trans({}, 'messages'),
    calories_kcal:      'overall.calories'|trans({}, 'messages'),
    heart_rate_avg:     'overall.heart_rate_avg'|trans({}, 'messages'),
    heart_rate_resting: 'overall.pulse'|trans({}, 'messages'),
    distance_meters:    'overall.distance'|trans({}, 'messages'),
    vo2_max:            'overall.vo2_max'|trans({}, 'messages'),
    chart_weight:       'overall.chart_weight'|trans({}, 'messages'),
    chart_reps:         'overall.chart_reps'|trans({}, 'messages'),
  }|json_encode|raw }},
};
</script>
<script src="{{ asset('js/dashboard.js') }}"></script>
{% endblock %}
