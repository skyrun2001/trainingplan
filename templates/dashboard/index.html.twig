{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block head %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<style>
/* ── Stats grid ── */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  margin-bottom: 12px;
}
@media (min-width: 480px) { .stats-grid { grid-template-columns: repeat(4, 1fr); } }
.stat-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 16px;
  text-align: center;
}
.stat-value { font-family: 'Space Mono', monospace; font-size: 28px; font-weight: 700; line-height: 1; margin-bottom: 4px; }
.stat-label { font-size: 11px; color: var(--dim); text-transform: uppercase; letter-spacing: 1px; }
.stat-sub   { font-size: 10px; color: var(--muted); margin-top: 2px; }

/* ── Weekly plan ── */
.week-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 6px;
  margin-bottom: 12px;
}
.week-day {
  border-radius: 12px;
  padding: 10px 4px 8px;
  text-align: center;
  border: 1px solid var(--border);
  background: var(--surface);
  cursor: default;
  transition: border-color 0.15s;
}
.week-day.is-today {
  border-color: var(--text);
  background: rgba(255,255,255,0.06);
}
.week-day.is-done  { border-color: rgba(34,197,94,0.3); background: rgba(34,197,94,0.05); }
.week-day.is-missed { border-color: rgba(201,24,74,0.2); background: rgba(201,24,74,0.04); }

.wd-label   { font-family: 'Space Mono', monospace; font-size: 10px; color: var(--muted); }
.wd-num     { font-size: 16px; font-weight: 700; margin: 2px 0 5px; }
.wd-type    { font-family: 'Space Mono', monospace; font-size: 9px; font-weight: 700;
              letter-spacing: 0.5px; padding: 3px 0; border-radius: 5px; margin: 0 2px 5px; }
.wd-type.t-push  { background: rgba(201,24,74,0.15);  color: var(--push); }
.wd-type.t-pull  { background: rgba(45,106,79,0.18);  color: #4CAF7D; }
.wd-type.t-legs  { background: rgba(224,159,62,0.15); color: var(--legs); }
.wd-type.t-upper { background: rgba(67,97,238,0.15);  color: #7B9EFF; }
.wd-type.t-rest  { color: var(--muted); font-size: 11px; }
.wd-status  { font-size: 14px; line-height: 1; }

/* ── Schedule editor ── */
.sched-editor {
  display: none;
  grid-template-columns: repeat(7, 1fr);
  gap: 6px;
  margin-top: 10px;
}
.sched-editor.open { display: grid; }
.sched-col { text-align: center; }
.sched-col label { font-size: 10px; color: var(--muted); font-family: 'Space Mono', monospace; display: block; margin-bottom: 4px; }
.sched-select {
  width: 100%;
  background: var(--surface2);
  border: 1px solid var(--border2);
  border-radius: 7px;
  color: var(--text);
  font-family: 'Space Mono', monospace;
  font-size: 9px;
  padding: 6px 2px;
  text-align: center;
  cursor: pointer;
  -webkit-appearance: none;
}
.sched-select:focus { outline: none; border-color: var(--text); }

/* ── Reminder ── */
.reminder-row {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid var(--border);
}
.reminder-row label { font-size: 12px; color: var(--dim); flex-shrink: 0; }
.reminder-time-input {
  background: var(--surface2);
  border: 1px solid var(--border2);
  border-radius: 8px;
  color: var(--text);
  font-family: 'Space Mono', monospace;
  font-size: 14px;
  padding: 6px 10px;
  width: 90px;
}
.reminder-time-input:focus { outline: none; border-color: var(--text); }
.notif-badge {
  font-size: 11px;
  padding: 3px 8px;
  border-radius: 6px;
  border: 1px solid var(--border2);
  background: var(--surface2);
  color: var(--muted);
}
.notif-badge.granted { color: var(--green); border-color: rgba(34,197,94,0.3); background: rgba(34,197,94,0.08); }
.notif-badge.denied  { color: var(--push);  border-color: rgba(201,24,74,0.3); background: rgba(201,24,74,0.08); }

/* ── Progress bars ── */
.week-bars { display: flex; gap: 8px; align-items: flex-end; height: 56px; }
.week-bar-wrap { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px; }
.week-bar { width: 100%; border-radius: 4px 4px 0 0; background: var(--surface2); min-height: 4px; }
.week-bar.has-data { background: #4361EE; opacity: 0.7; }
.week-label { font-size: 9px; color: var(--muted); font-family: 'Space Mono', monospace; }
.week-count { font-size: 10px; color: var(--dim); font-family: 'Space Mono', monospace; }

/* ── Chart ── */
.chart-container { position: relative; height: 200px; }
.exercise-select {
  background: var(--surface2); border: 1px solid var(--border2); border-radius: 9px;
  color: var(--text); font-family: 'Space Mono', monospace; font-size: 12px;
  padding: 9px 12px; width: 100%; margin-bottom: 14px; cursor: pointer;
}
.exercise-select:focus { outline: none; }
option { background: #1a1a1a; }

/* ── Personal bests ── */
.pb-row { display: flex; align-items: center; justify-content: space-between;
          padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.04); }
.pb-row:last-child { border-bottom: none; }
.pb-name { font-size: 13px; font-weight: 500; }
.pb-vals { display: flex; gap: 10px; font-family: 'Space Mono', monospace; font-size: 12px; color: var(--legs); }

/* ── History ── */
.session-item { display: flex; align-items: flex-start; gap: 12px; padding: 14px 0;
                border-bottom: 1px solid rgba(255,255,255,0.04); }
.session-item:last-child { border-bottom: none; }
.session-dot  { width: 10px; height: 10px; border-radius: 50%; margin-top: 4px; flex-shrink: 0; }
.session-body { flex: 1; min-width: 0; }
.session-title { font-size: 14px; font-weight: 600; }
.session-meta  { font-size: 12px; color: var(--dim); margin-top: 3px; }
.session-exercises { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 5px; }
.ex-pill { font-size: 11px; padding: 3px 8px; border-radius: 6px;
           background: var(--surface2); color: var(--dim); border: 1px solid var(--border); }

.empty-state { text-align: center; padding: 40px 20px; color: var(--muted); }
.empty-state a { color: var(--text); }

.type-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 12px; }
.type-stat { border-radius: 10px; padding: 12px 10px; text-align: center; }
.type-stat-val { font-family: 'Space Mono', monospace; font-size: 20px; font-weight: 700; }
.type-stat-lbl { font-size: 10px; color: var(--dim); margin-top: 2px; }

/* ── Health ── */
.health-metrics-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-bottom: 10px;
}
@media (max-width: 400px) { .health-metrics-grid { grid-template-columns: repeat(2, 1fr); } }
.health-card {
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px 10px;
  text-align: center;
}
.health-icon  { font-size: 20px; margin-bottom: 4px; }
.health-value { font-family: 'Space Mono', monospace; font-size: 18px; font-weight: 700; line-height: 1; }
.health-unit  { font-size: 10px; font-weight: 400; opacity: 0.7; }
.health-label { font-size: 9px; color: var(--dim); text-transform: uppercase; letter-spacing: 1px; margin-top: 3px; }
.health-meta  { font-size: 11px; color: var(--muted); margin-top: 10px; display:flex; align-items:center; gap:6px; }
.health-dot   { width:7px; height:7px; border-radius:50%; background:var(--green); display:inline-block; }

/* ── Health entry form ── */
.health-entry-toggle {
  display:flex; align-items:center; justify-content:space-between;
  padding:8px 0; cursor:pointer; color:var(--dim); font-size:12px;
  border-top:1px solid var(--border); margin-top:8px; user-select:none;
}
.health-entry-toggle:hover { color:var(--text); }
.health-entry-form { display:none; padding-top:10px; }
.health-entry-form.open { display:block; }
.health-entry-fields {
  display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-bottom: 8px;
}
.health-input-group { display:flex; flex-direction:column; gap:4px; }
.health-input-group label { font-size:10px; color:var(--muted); text-transform:uppercase; letter-spacing:0.5px; }
.health-input {
  background:var(--surface2); border:1px solid var(--border2);
  border-radius:8px; color:var(--text);
  font-family:'Space Mono',monospace; font-size:13px;
  padding:8px 10px; width:100%; box-sizing:border-box;
}
.health-input:focus { outline:none; border-color:var(--text); }

/* ── Health chart tabs ── */
.health-tab-bar  { display:flex; gap:5px; margin-bottom:8px; flex-wrap:wrap; }
.health-tab {
  font-size:10px; padding:3px 10px; border-radius:20px;
  border:1px solid var(--border2); background:var(--surface2);
  color:var(--muted); cursor:pointer; font-family:'Space Mono',monospace; transition:all 0.15s;
}
.health-tab.active { background:var(--text); color:#000; border-color:var(--text); }
.health-chart-wrap  { position:relative; height:120px; }
.health-chart-panel { display:none; }
.health-chart-panel.active { display:block; }

/* ── Health edit mode ── */
.health-edit-section { margin-bottom:14px; }
.health-edit-label { font-size:10px; color:var(--muted); text-transform:uppercase;
                     letter-spacing:1px; margin-bottom:7px; }
.edit-chips { display:flex; flex-wrap:wrap; gap:6px; }
.edit-chip {
  display:inline-flex; align-items:center; gap:5px;
  padding:5px 11px; border-radius:20px; cursor:pointer; font-size:12px;
  border:1px solid var(--border2); background:var(--surface2); color:var(--muted);
  user-select:none; transition:all 0.15s;
}
.edit-chip.on { border-color:var(--green); background:rgba(34,197,94,0.1); color:var(--green); }
.edit-chip:hover { border-color:var(--text); color:var(--text); }
.day-btns { display:flex; gap:6px; flex-wrap:wrap; }
.day-btn {
  padding:5px 14px; border-radius:20px; font-size:12px; cursor:pointer;
  border:1px solid var(--border2); background:var(--surface2); color:var(--muted); transition:all 0.15s;
}
.day-btn.active { border-color:var(--accent); color:var(--accent); background:rgba(67,97,238,0.08); }
</style>
{% endblock %}

{% block body %}
<div class="page">
  <div class="page-header">
    <div class="page-label">Trainingsplan</div>
    <div class="page-title">Dashboard</div>
    <div class="page-sub">{{ app.user.username }} · Ziel: Top Form Mai 2027</div>
  </div>

  {% if totalSessions == 0 %}
    <div class="empty-state">
      <div style="font-size:48px;margin-bottom:12px">🏋️</div>
      <div style="font-size:16px;font-weight:600;color:var(--text);margin-bottom:6px">Noch keine Trainings geloggt</div>
      <div style="margin-bottom:20px">Starte jetzt dein erstes Training!</div>
      <a href="{{ path('app_log') }}" class="btn btn-primary">Training starten</a>
    </div>
  {% else %}

  {# ── KPIs ── #}
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-value" style="color:#22c55e">{{ streak }}</div>
      <div class="stat-label">Streak</div><div class="stat-sub">Tage in Folge</div>
    </div>
    <div class="stat-card">
      <div class="stat-value">{{ totalSessions }}</div>
      <div class="stat-label">Total</div><div class="stat-sub">Trainings</div>
    </div>
    <div class="stat-card">
      <div class="stat-value" style="color:var(--legs)">{{ weeklyData|map(w => w.count)|reduce((a,b) => a+b, 0) }}</div>
      <div class="stat-label">4 Wochen</div><div class="stat-sub">Trainings</div>
    </div>
    <div class="stat-card">
      <div class="stat-value" style="color:var(--upper)">{{ sessions|first ? sessions|first.date|date('d.m') : '—' }}</div>
      <div class="stat-label">Letztes</div><div class="stat-sub">Training</div>
    </div>
  </div>
  {% endif %}

  {# ── Weekly plan ── #}
  <div class="card">
    <div class="card-title" style="display:flex;justify-content:space-between;align-items:center">
      <span>Diese Woche</span>
      <button class="btn btn-ghost btn-sm" id="schedEditBtn" onclick="toggleScheduleEditor()">✎ Anpassen</button>
    </div>

    <div class="week-grid" id="weekGrid">
      {% for day in weekDays %}
        {% set stateClass = '' %}
        {% if day.hasSessions %}
          {% set stateClass = 'is-done' %}
        {% elseif day.isToday %}
          {% set stateClass = 'is-today' %}
        {% elseif day.isPast and day.scheduledType %}
          {% set stateClass = 'is-missed' %}
        {% endif %}

        <div class="week-day {{ stateClass }}">
          <div class="wd-label">{{ day.label }}</div>
          <div class="wd-num">{{ day.dayNum }}</div>
          {% if day.scheduledType %}
            <div class="wd-type t-{{ day.scheduledType }}">{{ day.scheduledType|upper }}</div>
          {% else %}
            <div class="wd-type t-rest">—</div>
          {% endif %}
          <div class="wd-status">
            {% if day.hasSessions %}
              <span style="color:var(--green)">✓</span>
            {% elseif day.isToday and day.scheduledType %}
              🎯
            {% elseif day.isToday %}
              ●
            {% elseif day.isPast and day.scheduledType %}
              <span style="color:var(--push)">✗</span>
            {% elseif day.scheduledType %}
              <span style="color:var(--muted)">○</span>
            {% else %}
              <span style="color:var(--muted)">—</span>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    {# Schedule editor #}
    <div class="sched-editor" id="schedEditor">
      {% set typeOptions = {'': '—', 'push': 'PUSH', 'pull': 'PULL', 'legs': 'BEIN', 'upper': 'UPPR'} %}
      {% for day in weekDays %}
        <div class="sched-col">
          <label>{{ day.label }}</label>
          <select class="sched-select" data-weekday="{{ day.isoWeekday }}" onchange="saveSchedule()">
            {% for val, lbl in typeOptions %}
              <option value="{{ val }}" {% if schedule[day.isoWeekday] == val %}selected{% endif %}>{{ lbl }}</option>
            {% endfor %}
          </select>
        </div>
      {% endfor %}
    </div>

    {# Reminder #}
    <div class="reminder-row">
      <label>🔔 Erinnerung</label>
      <input type="time" class="reminder-time-input" id="reminderTime"
             value="{{ reminderTime ?? '' }}"
             onchange="saveReminderTime(this.value)">
      <span class="notif-badge" id="notifBadge">Klicken zum Erlauben</span>
      <button class="btn btn-ghost btn-sm" onclick="requestNotifPermission()">Erlauben</button>
      <span style="font-size:11px;color:var(--muted)">* Erinnerung nur bei geöffnetem Browser</span>
    </div>
  </div>

  {# ── Health data ── #}
  <div class="card">
    <div class="card-title" style="display:flex;justify-content:space-between;align-items:center">
      <span>Gesundheit</span>
      <div style="display:flex;gap:8px;align-items:center">
        <span style="font-size:11px;color:var(--muted)">{{ "now"|date('d.m.Y') }}</span>
        <button class="btn btn-ghost btn-sm" id="healthEditBtn" onclick="toggleHealthEdit()">✎</button>
      </div>
    </div>

    {# — Edit panel (hidden by default) — #}
    <div id="healthEditPanel" style="display:none;padding-bottom:12px;border-bottom:1px solid var(--border);margin-bottom:12px">
      <div class="health-edit-section">
        <div class="health-edit-label">Karten anzeigen</div>
        <div class="edit-chips" id="cardChips"></div>
      </div>
      <div class="health-edit-section">
        <div class="health-edit-label">Diagramme</div>
        <div class="edit-chips" id="chartChips"></div>
      </div>
      <div class="health-edit-section">
        <div class="health-edit-label">Zeitraum</div>
        <div class="day-btns">
          <button class="day-btn" data-days="7"  onclick="setChartDays(7,this)">7 T</button>
          <button class="day-btn" data-days="14" onclick="setChartDays(14,this)">14 T</button>
          <button class="day-btn" data-days="30" onclick="setChartDays(30,this)">30 T</button>
          <button class="day-btn" data-days="60" onclick="setChartDays(60,this)">60 T</button>
          <button class="day-btn" data-days="90" onclick="setChartDays(90,this)">90 T</button>
        </div>
      </div>
      <button class="btn btn-primary btn-sm" onclick="saveHealthConfig()" style="margin-top:4px">Speichern</button>
    </div>

    {# — Metric cards (populated by JS) — #}
    <div class="health-metrics-grid" id="healthMetricsGrid"></div>

    {# — Charts (populated by JS) — #}
    <div id="healthChartsContainer" style="margin-top:12px"></div>

    {# — Manual entry form — #}
    <div class="health-entry-toggle" onclick="toggleHealthForm()" id="healthToggle">
      <span>✎ Daten erfassen</span>
      <span id="healthToggleArrow">▼</span>
    </div>
    <div class="health-entry-form" id="healthForm">
      <div class="health-input-group" style="margin-bottom:8px">
        <label>Datum</label>
        <input type="date" class="health-input" id="healthDate"
               value="{{ "now"|date('Y-m-d') }}" max="{{ "now"|date('Y-m-d') }}">
      </div>
      <div class="health-entry-fields" id="healthEntryFields"></div>
      <div style="display:flex;gap:8px;align-items:center;margin-top:8px">
        <button class="btn btn-primary btn-sm" onclick="saveHealthEntry()" id="healthSaveBtn">Speichern</button>
        <span id="healthSaveMsg" style="font-size:12px;color:var(--green);display:none">✓ Gespeichert</span>
      </div>
    </div>

    <div class="health-meta">
      <span class="health-dot"></span>
      Synchronisiert über Android App · Manuelle Eingabe möglich
    </div>
  </div>

  {% if totalSessions > 0 %}
  {# ── Split distribution ── #}
  <div class="card">
    <div class="card-title">Split-Verteilung</div>
    <div class="type-stats">
      {% for key, cfg in {'push':{'label':'Push','color':'var(--push)'},'pull':{'label':'Pull','color':'#4CAF7D'},'legs':{'label':'Beine','color':'var(--legs)'},'upper':{'label':'Upper','color':'#7B9EFF'}} %}
        <div class="type-stat tag-{{ key }}">
          <div class="type-stat-val" style="color:{{ cfg.color }}">{{ typeMap[key] ?? 0 }}</div>
          <div class="type-stat-lbl">{{ cfg.label }}</div>
        </div>
      {% endfor %}
    </div>
  </div>

  {# ── 4-week bars ── #}
  <div class="card">
    <div class="card-title">Letzte 4 Wochen</div>
    {% set maxCount = max(weeklyData|map(w => w.count)) %}
    <div class="week-bars">
      {% for week in weeklyData %}
        {% set heightPct = maxCount > 0 ? (week.count / maxCount * 100)|round : 0 %}
        <div class="week-bar-wrap">
          <div class="week-count">{{ week.count }}</div>
          <div class="week-bar {% if week.count > 0 %}has-data{% endif %}"
               style="height:{{ max(heightPct, 10) }}%"></div>
          <div class="week-label">{{ week.label }}</div>
        </div>
      {% endfor %}
    </div>
  </div>

  {# ── Progression chart ── #}
  {% if exerciseNames is not empty %}
  <div class="card">
    <div class="card-title">Progression</div>
    <select class="exercise-select" id="exerciseSelect" onchange="loadChart(this.value)">
      <option value="">— Übung wählen —</option>
      {% for name in exerciseNames %}
        <option value="{{ name }}">{{ name }}</option>
      {% endfor %}
    </select>
    <div class="chart-container"><canvas id="progressionChart"></canvas></div>
    <div id="chartEmpty" style="text-align:center;color:var(--muted);font-size:13px;padding:30px 0;display:none">
      Noch keine Daten für diese Übung.
    </div>
  </div>
  {% endif %}

  {# ── Personal bests ── #}
  {% if personalBests is not empty %}
  <div class="card">
    <div class="card-title">Persönliche Bestleistungen</div>
    {% for pb in personalBests %}
      {% if pb.maxWeight is not null %}
      <div class="pb-row">
        <div class="pb-name">{{ pb.exerciseName }}</div>
        <div class="pb-vals"><span>{{ pb.maxWeight }} kg</span><span style="color:var(--dim)">×{{ pb.maxReps }}</span></div>
      </div>
      {% endif %}
    {% endfor %}
  </div>
  {% endif %}

  {# ── History ── #}
  <div class="card">
    <div class="card-title" style="display:flex;justify-content:space-between;align-items:center">
      <span>Trainingshistorie</span>
      <a href="{{ path('app_log') }}" class="btn btn-ghost btn-sm">+ Neu</a>
    </div>
    {% for session in sessions %}
      <div class="session-item" id="session-{{ session.id }}">
        <div class="session-dot" style="background:{{ session.typeColor }}"></div>
        <div class="session-body">
          <div class="session-title">{{ session.typeLabel }}</div>
          <div class="session-meta">
            {{ session.date|date('d.m.Y') }}
            {% if session.durationMinutes %} · {{ session.durationMinutes }} Min{% endif %}
            · {{ session.exerciseLogs|length }} Sätze
          </div>
          {% if session.exerciseLogs is not empty %}
            <div class="session-exercises">
              {% set seen = [] %}
              {% for log in session.exerciseLogs %}
                {% if log.exerciseName not in seen %}
                  {% set seen = seen|merge([log.exerciseName]) %}
                  <span class="ex-pill">{{ log.exerciseName }}</span>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
          {% if session.notes %}
            <div style="font-size:12px;color:var(--muted);margin-top:6px;font-style:italic">{{ session.notes }}</div>
          {% endif %}
        </div>
        <button class="btn btn-danger btn-sm" onclick="deleteSession({{ session.id }})">✕</button>
      </div>
    {% endfor %}
  </div>
  {% endif %}
</div>
{% endblock %}

{% block scripts %}
<script>
// ── Schedule editor ──────────────────────────────────────────────────────────
function toggleScheduleEditor() {
  document.getElementById('schedEditor').classList.toggle('open');
}

async function saveSchedule() {
  const weekSchedule = {};
  document.querySelectorAll('.sched-select').forEach(s => {
    weekSchedule[s.dataset.weekday] = s.value || null;
  });
  const r = await fetch('/api/settings', {
    method:  'PATCH',
    headers: { 'Content-Type': 'application/json' },
    body:    JSON.stringify({ weekSchedule }),
  });
  if (r.ok) {
    showToast('Wochenplan gespeichert ✓');
    setTimeout(() => location.reload(), 600);
  } else {
    showToast('Fehler beim Speichern', 'error');
  }
}

// ── Notifications ────────────────────────────────────────────────────────────
function updateNotifBadge() {
  const badge = document.getElementById('notifBadge');
  if (!('Notification' in window)) {
    badge.textContent = 'Nicht unterstützt';
    return;
  }
  const perm = Notification.permission;
  badge.className = 'notif-badge' + (perm === 'granted' ? ' granted' : perm === 'denied' ? ' denied' : '');
  badge.textContent = perm === 'granted' ? '✓ Erlaubt' : perm === 'denied' ? '✗ Blockiert' : 'Klicken zum Erlauben';
}

async function requestNotifPermission() {
  if (!('Notification' in window)) { showToast('Browser unterstützt keine Benachrichtigungen', 'error'); return; }
  const perm = await Notification.requestPermission();
  updateNotifBadge();
  if (perm === 'granted') showToast('Benachrichtigungen erlaubt ✓');
  else showToast('Benachrichtigungen blockiert', 'error');
}

async function saveReminderTime(val) {
  await fetch('/api/settings', {
    method:  'PATCH',
    headers: { 'Content-Type': 'application/json' },
    body:    JSON.stringify({ reminderTime: val || null }),
  });
  showToast(val ? `Erinnerung auf ${val} Uhr gesetzt ✓` : 'Erinnerung deaktiviert');
  scheduleReminderCheck();
}

{% set _today = weekDays|filter(d => d.isToday)|first|default(null) %}
// Schedule for today's gym type from the page data
const todayScheduledType = "{{ _today ? _today.scheduledType|default('') : '' }}";
const todayHasSessions   = {{ (_today and _today.hasSessions) ? 'true' : 'false' }};
const typeLabels         = {push:'Push — Brust, Schulter, Trizeps', pull:'Pull — Rücken, Bizeps', legs:'Beine — Komplett', upper:'Upper — Schwachpunkte'};

let reminderInterval = null;

function scheduleReminderCheck() {
  if (reminderInterval) clearInterval(reminderInterval);
  const timeInput = document.getElementById('reminderTime');
  if (!timeInput?.value) return;
  if (Notification.permission !== 'granted') return;

  reminderInterval = setInterval(() => {
    const now  = new Date();
    const hhmm = now.getHours().toString().padStart(2,'0') + ':' + now.getMinutes().toString().padStart(2,'0');
    if (hhmm !== timeInput.value) return;
    if (!todayScheduledType || todayHasSessions) return;

    new Notification('🏋️ Zeit fürs Training!', {
      body: `Heute: ${typeLabels[todayScheduledType] ?? todayScheduledType}. Viel Erfolg!`,
      icon: '/favicon.ico',
      tag:  'gym-reminder',
    });
  }, 60000);
}

// Init on load
updateNotifBadge();
scheduleReminderCheck();

// ── Progression chart ────────────────────────────────────────────────────────
{% if exerciseNames is not empty %}
let chart = null;
function loadChart(name) {
  const canvas = document.getElementById('progressionChart');
  const empty  = document.getElementById('chartEmpty');
  if (!name) { if (chart) chart.destroy(); canvas.style.display='none'; empty.style.display='none'; return; }

  fetch('/api/progression/' + encodeURIComponent(name))
    .then(r => r.json())
    .then(data => {
      if (!data?.length) {
        if (chart) chart.destroy();
        canvas.style.display='none'; empty.style.display='block'; return;
      }
      empty.style.display='none'; canvas.style.display='block';
      if (chart) chart.destroy();
      chart = new Chart(canvas, {
        type: 'line',
        data: {
          labels: data.map(d => d.date),
          datasets: [
            { label:'Max. Gewicht (kg)', data: data.map(d => d.maxWeight), borderColor:'#C9184A',
              backgroundColor:'rgba(201,24,74,0.08)', fill:true, tension:0.3,
              pointBackgroundColor:'#C9184A', pointRadius:4, yAxisID:'yWeight' },
            { label:'Max. Wiederholungen', data: data.map(d => d.maxReps), borderColor:'#4361EE',
              fill:false, tension:0.3, pointBackgroundColor:'#4361EE', pointRadius:4,
              yAxisID:'yReps', borderDash:[4,3] }
          ]
        },
        options: {
          responsive:true, maintainAspectRatio:false,
          interaction:{ mode:'index', intersect:false },
          plugins:{
            legend:{ labels:{ color:'#888', font:{family:'DM Sans',size:12}, boxWidth:12 }},
            tooltip:{ backgroundColor:'#1a1a1a', borderColor:'rgba(255,255,255,0.1)', borderWidth:1,
                      titleColor:'#E8E4DE', bodyColor:'#888' }
          },
          scales:{
            x:{ ticks:{color:'#555',font:{family:'Space Mono',size:10},maxTicksLimit:8},
                grid:{color:'rgba(255,255,255,0.04)'} },
            yWeight:{ position:'left', ticks:{color:'#C9184A',font:{family:'Space Mono',size:10},callback:v=>v+' kg'},
                      grid:{color:'rgba(255,255,255,0.04)'} },
            yReps:  { position:'right', ticks:{color:'#4361EE',font:{family:'Space Mono',size:10}},
                      grid:{drawOnChartArea:false} }
          }
        }
      });
    });
}

const firstEx = document.getElementById('exerciseSelect');
if (firstEx?.options.length > 1) { firstEx.selectedIndex = 1; loadChart(firstEx.value); }
{% endif %}

// ── Health Dashboard ─────────────────────────────────────────────────────────
const todayMetrics  = {{ todayMetrics|json_encode|raw }};
const availableKeys = {{ availableKeys|json_encode|raw }};
let hdConfig        = {{ healthDashboard|json_encode|raw }};
let rawChartData    = {{ healthChartJson|raw }};

function hexToRgba(hex, a) {
  const r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16);
  return `rgba(${r},${g},${b},${a})`;
}

const METRIC_DEFS = {
  steps:              { icon:'👣', color:'#6DB6FF', label:'Schritte',   fmt:v=>v>=1000?(v/1000).toFixed(1)+'k':String(Math.round(v)), chartType:'bar'  },
  sleep_minutes:      { icon:'💤', color:'#9C84F7', label:'Schlaf',     fmt:v=>`${Math.floor(v/60)}h ${Math.round(v%60)}m`,          chartType:'bar'  },
  active_minutes:     { icon:'🏃', color:'#22c55e', label:'Aktiv Min',  fmt:v=>Math.round(v)+'min',                                  chartType:'bar'  },
  weight_kg:          { icon:'⚖️', color:'#E0A03E', label:'Gewicht',    fmt:v=>v.toFixed(1)+' kg',                                   chartType:'line' },
  calories_kcal:      { icon:'🔥', color:'#FF8C42', label:'Kalorien',   fmt:v=>Math.round(v)+' kcal',                                chartType:'bar'  },
  heart_rate_avg:     { icon:'❤️', color:'#ef4444', label:'Herzrate Ø', fmt:v=>Math.round(v)+' bpm',                                 chartType:'line' },
  heart_rate_resting: { icon:'💗', color:'#f87171', label:'Ruhepuls',   fmt:v=>Math.round(v)+' bpm',                                 chartType:'line' },
  distance_meters:    { icon:'📍', color:'#60a5fa', label:'Distanz',    fmt:v=>v>=1000?(v/1000).toFixed(2)+' km':Math.round(v)+' m', chartType:'bar'  },
  vo2_max:            { icon:'💨', color:'#a78bfa', label:'VO2 Max',    fmt:v=>v.toFixed(1),                                         chartType:'line' },
};

function metaDef(key) {
  return METRIC_DEFS[key] ?? {
    icon: '📊', color: '#888888',
    label: key.replace(/_/g,' ').replace(/\b\w/g, c => c.toUpperCase()),
    fmt:  v => Number.isInteger(v) ? String(v) : v.toFixed(1),
    chartType: 'line',
  };
}

// ── Metric cards ──────────────────────────────────────────────────────────────
function renderCards() {
  const grid = document.getElementById('healthMetricsGrid');
  grid.innerHTML = '';
  if (!hdConfig.cards.length) {
    grid.innerHTML = '<p style="color:var(--muted);font-size:12px;grid-column:1/-1;text-align:center;margin:8px 0">Keine Karten — ✎ zum Anpassen</p>';
    return;
  }
  hdConfig.cards.forEach(({ metric }) => {
    const d   = metaDef(metric);
    const val = todayMetrics[metric] ?? null;
    const el  = document.createElement('div');
    el.className = 'health-card';
    el.innerHTML = `<div class="health-icon">${d.icon}</div>
<div class="health-value" style="color:${d.color}">${val !== null ? d.fmt(val) : '—'}</div>
<div class="health-label">${d.label}</div>`;
    grid.appendChild(el);
  });
}

// ── Charts ────────────────────────────────────────────────────────────────────
const hCharts = {};

function renderCharts() {
  const wrap = document.getElementById('healthChartsContainer');
  wrap.innerHTML = '';
  Object.values(hCharts).forEach(c => c.destroy());
  Object.keys(hCharts).forEach(k => delete hCharts[k]);

  const metrics = hdConfig.chartMetrics;
  if (!metrics.length || rawChartData.length < 2) return;

  const tabBar = document.createElement('div');
  tabBar.className = 'health-tab-bar';
  wrap.appendChild(tabBar);

  const baseOpts = {
    responsive: true, maintainAspectRatio: false,
    interaction: { mode: 'index', intersect: false },
    plugins: {
      legend: { display: false },
      tooltip: { backgroundColor:'#1a1a1a', titleColor:'#E8E4DE', bodyColor:'#888',
                 borderColor:'rgba(255,255,255,0.08)', borderWidth:1 },
    },
    scales: {
      x: { ticks:{ color:'#555', font:{ family:'Space Mono', size:9 }, maxTicksLimit:12 },
           grid:{ color:'rgba(255,255,255,0.04)' } },
      y: { ticks:{ color:'#666', font:{ family:'Space Mono', size:9 } },
           grid:{ color:'rgba(255,255,255,0.04)' } },
    },
  };

  const labels = rawChartData.map(row => { const [,m,day]=row.date.split('-'); return day+'.'+m; });

  metrics.forEach((metric, i) => {
    const d = metaDef(metric);

    const tab = document.createElement('button');
    tab.className = 'health-tab' + (i===0 ? ' active' : '');
    tab.textContent = d.label;
    tab.onclick = () => switchHealthTab(metric, tab);
    tabBar.appendChild(tab);

    const panel = document.createElement('div');
    panel.className = 'health-chart-panel' + (i===0 ? ' active' : '');
    panel.id = 'hpanel-' + metric;
    const cWrap = document.createElement('div');
    cWrap.className = 'health-chart-wrap';
    const canvas = document.createElement('canvas');
    canvas.id = 'hchart-' + metric;
    cWrap.appendChild(canvas);
    panel.appendChild(cWrap);
    wrap.appendChild(panel);

    const isLine = d.chartType === 'line';
    hCharts[metric] = new Chart(canvas, {
      type: isLine ? 'line' : 'bar',
      data: {
        labels,
        datasets: [{
          label: d.label,
          data:  rawChartData.map(row => row[metric] ?? null),
          borderColor:     d.color,
          backgroundColor: hexToRgba(d.color, isLine ? 0.12 : 0.5),
          fill: isLine, tension: 0.3,
          pointRadius:  isLine ? 3 : undefined,
          spanGaps:     true,
          borderRadius: isLine ? undefined : 3,
          borderWidth:  isLine ? 2 : 1,
        }],
      },
      options: baseOpts,
    });
  });
}

function switchHealthTab(metric, btn) {
  document.querySelectorAll('.health-tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.health-chart-panel').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('hpanel-' + metric)?.classList.add('active');
}

// ── Edit mode ─────────────────────────────────────────────────────────────────
function toggleHealthEdit() {
  const panel = document.getElementById('healthEditPanel');
  const btn   = document.getElementById('healthEditBtn');
  const open  = panel.style.display === 'none';
  panel.style.display = open ? 'block' : 'none';
  btn.textContent = open ? '✕' : '✎';
  if (open) renderEditChips();
}

function renderEditChips() {
  const cardChips  = document.getElementById('cardChips');
  const chartChips = document.getElementById('chartChips');
  cardChips.innerHTML = chartChips.innerHTML = '';

  const activeCards  = hdConfig.cards.map(c => c.metric);
  const activeCharts = hdConfig.chartMetrics;

  const mkChip = (key, isOn, toggle) => {
    const d    = metaDef(key);
    const chip = document.createElement('div');
    chip.className = 'edit-chip' + (isOn ? ' on' : '');
    chip.textContent = d.icon + ' ' + d.label;
    chip.onclick = () => toggle(chip);
    return chip;
  };

  availableKeys.forEach(key => {
    cardChips.appendChild(mkChip(key, activeCards.includes(key), chip => {
      const idx = hdConfig.cards.findIndex(c => c.metric === key);
      if (idx >= 0) hdConfig.cards.splice(idx, 1); else hdConfig.cards.push({ metric: key });
      chip.classList.toggle('on', hdConfig.cards.some(c => c.metric === key));
    }));
    chartChips.appendChild(mkChip(key, activeCharts.includes(key), chip => {
      const idx = hdConfig.chartMetrics.indexOf(key);
      if (idx >= 0) hdConfig.chartMetrics.splice(idx, 1); else hdConfig.chartMetrics.push(key);
      chip.classList.toggle('on', hdConfig.chartMetrics.includes(key));
    }));
  });

  document.querySelectorAll('.day-btn').forEach(b => {
    b.classList.toggle('active', parseInt(b.dataset.days) === hdConfig.chartDays);
  });
}

function setChartDays(days, btn) {
  hdConfig.chartDays = days;
  document.querySelectorAll('.day-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
}

async function saveHealthConfig() {
  const r = await fetch('/api/settings', {
    method: 'PATCH', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ healthDashboard: hdConfig }),
  });
  if (!r.ok) { showToast('Fehler beim Speichern', 'error'); return; }
  showToast('Dashboard gespeichert ✓');
  toggleHealthEdit();
  const res = await fetch('/api/health/data?days=' + hdConfig.chartDays);
  rawChartData = await res.json();
  renderCards();
  renderCharts();
  renderEntryForm();
}

// ── Entry form ────────────────────────────────────────────────────────────────
function renderEntryForm() {
  const container = document.getElementById('healthEntryFields');
  container.innerHTML = '';
  const shown = [...new Set([...hdConfig.cards.map(c => c.metric), ...hdConfig.chartMetrics])];
  const keys  = shown.length ? shown : ['steps','weight_kg','calories_kcal','sleep_minutes','active_minutes'];
  keys.forEach(key => {
    const d   = metaDef(key);
    const cur = todayMetrics[key] ?? '';
    const grp = document.createElement('div');
    grp.className = 'health-input-group';
    grp.innerHTML = `<label>${d.icon} ${d.label}</label>
<input type="number" class="health-input health-entry-input" data-metric="${key}"
       placeholder="—" value="${cur !== '' ? cur : ''}" step="any" min="0">`;
    container.appendChild(grp);
  });
}

function toggleHealthForm() {
  const form  = document.getElementById('healthForm');
  const arrow = document.getElementById('healthToggleArrow');
  const open  = form.classList.toggle('open');
  arrow.textContent = open ? '▲' : '▼';
}

async function saveHealthEntry() {
  const btn     = document.getElementById('healthSaveBtn');
  const msg     = document.getElementById('healthSaveMsg');
  const date    = document.getElementById('healthDate').value;
  const metrics = {};

  document.querySelectorAll('.health-entry-input').forEach(inp => {
    if (inp.value.trim() !== '') metrics[inp.dataset.metric] = parseFloat(inp.value);
  });

  if (!Object.keys(metrics).length) { showToast('Bitte mindestens einen Wert eingeben', 'error'); return; }

  btn.disabled = true;
  try {
    const r    = await fetch('/health/save', { method:'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ date, metrics }) });
    const data = await r.json();
    if (data.success) {
      Object.assign(todayMetrics, data.saved ?? {});
      msg.style.display = 'inline';
      setTimeout(() => { msg.style.display = 'none'; }, 3000);
      renderCards();
    } else {
      showToast(data.error ?? 'Fehler', 'error');
    }
  } catch { showToast('Verbindungsfehler', 'error'); }
  finally  { btn.disabled = false; }
}

// Init
renderCards();
renderCharts();
renderEntryForm();

// ── History delete ───────────────────────────────────────────────────────────
function deleteSession(id) {
  if (!confirm('Training wirklich löschen?')) return;
  fetch('/log/' + id + '/delete', { method:'DELETE' })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        const el = document.getElementById('session-' + id);
        el.style.opacity='0'; el.style.transition='opacity 0.3s';
        setTimeout(() => { el.remove(); showToast('Training gelöscht'); }, 300);
      }
    });
}
</script>
