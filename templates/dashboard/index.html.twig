{% extends 'base.html.twig' %}

{% block title %}Dashboard – Lukas{% endblock %}

{% block head %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<style>
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  margin-bottom: 12px;
}
@media (min-width: 480px) { .stats-grid { grid-template-columns: repeat(4, 1fr); } }

.stat-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 16px;
  text-align: center;
}
.stat-value {
  font-family: 'Space Mono', monospace;
  font-size: 28px;
  font-weight: 700;
  line-height: 1;
  margin-bottom: 4px;
}
.stat-label { font-size: 11px; color: var(--dim); text-transform: uppercase; letter-spacing: 1px; }
.stat-sub   { font-size: 10px; color: var(--muted); margin-top: 2px; }

.week-bars {
  display: flex;
  gap: 8px;
  align-items: flex-end;
  height: 60px;
}
.week-bar-wrap { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px; }
.week-bar {
  width: 100%;
  border-radius: 4px 4px 0 0;
  background: var(--surface2);
  min-height: 4px;
  transition: height 0.4s;
  position: relative;
}
.week-bar.has-data { background: var(--accent, #888); opacity: 0.8; }
.week-label { font-size: 9px; color: var(--muted); font-family: 'Space Mono', monospace; }
.week-count { font-size: 10px; color: var(--dim); font-family: 'Space Mono', monospace; }

.session-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 14px 0;
  border-bottom: 1px solid rgba(255,255,255,0.04);
}
.session-item:last-child { border-bottom: none; }
.session-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  margin-top: 4px;
  flex-shrink: 0;
}
.session-body { flex: 1; min-width: 0; }
.session-title { font-size: 14px; font-weight: 600; line-height: 1.3; }
.session-meta { font-size: 12px; color: var(--dim); margin-top: 3px; }
.session-exercises {
  margin-top: 8px;
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}
.ex-pill {
  font-size: 11px;
  padding: 3px 8px;
  border-radius: 6px;
  background: var(--surface2);
  color: var(--dim);
  border: 1px solid var(--border);
}
.session-actions { display: flex; gap: 6px; align-items: center; }

.chart-container { position: relative; height: 200px; }

.exercise-select {
  background: var(--surface2);
  border: 1px solid var(--border2);
  border-radius: 9px;
  color: var(--text);
  font-family: 'Space Mono', monospace;
  font-size: 12px;
  padding: 9px 12px;
  width: 100%;
  margin-bottom: 14px;
  cursor: pointer;
}
.exercise-select:focus { outline: none; border-color: var(--accent, #C9184A); }
option { background: #1a1a1a; }

.pb-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 0;
  border-bottom: 1px solid rgba(255,255,255,0.04);
}
.pb-row:last-child { border-bottom: none; }
.pb-name { font-size: 13px; font-weight: 500; }
.pb-vals {
  display: flex;
  gap: 10px;
  font-family: 'Space Mono', monospace;
  font-size: 12px;
  color: var(--legs);
}

.empty-state {
  text-align: center;
  padding: 40px 20px;
  color: var(--muted);
}
.empty-state a { color: var(--text); }

.tab-row {
  display: flex;
  gap: 6px;
  margin-bottom: 14px;
}
.tab-btn {
  padding: 7px 14px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  border: 1px solid var(--border2);
  background: var(--surface);
  color: var(--dim);
  font-family: inherit;
  transition: all 0.15s;
}
.tab-btn.active { background: var(--surface2); color: var(--text); border-color: rgba(255,255,255,0.2); }

.type-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
  margin-bottom: 12px;
}
.type-stat {
  border-radius: 10px;
  padding: 12px 10px;
  text-align: center;
}
.type-stat-val { font-family: 'Space Mono', monospace; font-size: 20px; font-weight: 700; }
.type-stat-lbl { font-size: 10px; color: var(--dim); margin-top: 2px; }
</style>
{% endblock %}

{% block body %}
<div class="page">
  <div class="page-header">
    <div class="page-label">Trainingsplan</div>
    <div class="page-title">Dashboard</div>
    <div class="page-sub">71,7 kg · Ziel: Top Form Mai 2027</div>
  </div>

  {% if totalSessions == 0 %}
    <div class="empty-state">
      <div style="font-size:48px;margin-bottom:12px">🏋️</div>
      <div style="font-size:16px;font-weight:600;color:var(--text);margin-bottom:6px">Noch keine Trainings geloggt</div>
      <div style="margin-bottom:20px">Starte jetzt dein erstes Training!</div>
      <a href="{{ path('app_log') }}" class="btn btn-primary">Training starten</a>
    </div>
  {% else %}

  {# ── KPIs ── #}
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-value" style="color:#22c55e">{{ streak }}</div>
      <div class="stat-label">Streak</div>
      <div class="stat-sub">Tage in Folge</div>
    </div>
    <div class="stat-card">
      <div class="stat-value">{{ totalSessions }}</div>
      <div class="stat-label">Total</div>
      <div class="stat-sub">Trainings</div>
    </div>
    <div class="stat-card">
      <div class="stat-value" style="color:var(--legs)">{{ weeklyData|map(w => w.count)|reduce((a,b) => a+b, 0) }}</div>
      <div class="stat-label">4 Wochen</div>
      <div class="stat-sub">Trainings</div>
    </div>
    <div class="stat-card">
      <div class="stat-value" style="color:var(--upper)">{{ sessions|first ? sessions|first.date|date('d.m') : '—' }}</div>
      <div class="stat-label">Letztes</div>
      <div class="stat-sub">Training</div>
    </div>
  </div>

  {# ── Type distribution ── #}
  <div class="card">
    <div class="card-title">Split-Verteilung</div>
    <div class="type-stats">
      {% set types = {'push': {'label':'Push','color':'var(--push)'},'pull':{'label':'Pull','color':'#4CAF7D'},'legs':{'label':'Beine','color':'var(--legs)'},'upper':{'label':'Upper','color':'#7B9EFF)'}} %}
      {% for key, cfg in types %}
        <div class="type-stat tag-{{ key }}">
          <div class="type-stat-val" style="color:{{ cfg.color }}">{{ typeMap[key] ?? 0 }}</div>
          <div class="type-stat-lbl">{{ cfg.label }}</div>
        </div>
      {% endfor %}
    </div>
  </div>

  {# ── Weekly overview ── #}
  <div class="card">
    <div class="card-title">Letzte 4 Wochen</div>
    {% set maxCount = weeklyData|map(w => w.count)|max %}
    <div class="week-bars">
      {% for week in weeklyData %}
        {% set heightPct = maxCount > 0 ? (week.count / maxCount * 100)|round : 0 %}
        <div class="week-bar-wrap">
          <div class="week-count">{{ week.count }}</div>
          <div class="week-bar {% if week.count > 0 %}has-data{% endif %}"
               style="height:{{ [heightPct, 10]|max }}%; {% if week.count > 0 %}--accent: #{{ ['C9184A','4CAF7D','E09F3E','4361EE']|random }};{% endif %}"></div>
          <div class="week-label">{{ week.label }}</div>
        </div>
      {% endfor %}
    </div>
  </div>

  {# ── Progression chart ── #}
  {% if exerciseNames is not empty %}
  <div class="card">
    <div class="card-title">Progression</div>
    <select class="exercise-select" id="exerciseSelect" onchange="loadChart(this.value)">
      <option value="">— Übung wählen —</option>
      {% for name in exerciseNames %}
        <option value="{{ name }}">{{ name }}</option>
      {% endfor %}
    </select>
    <div class="chart-container">
      <canvas id="progressionChart"></canvas>
    </div>
    <div id="chartEmpty" style="text-align:center;color:var(--muted);font-size:13px;padding:30px 0;display:none">
      Noch keine Daten für diese Übung.
    </div>
  </div>
  {% endif %}

  {# ── Personal bests ── #}
  {% if personalBests is not empty %}
  <div class="card">
    <div class="card-title">Persönliche Bestleistungen</div>
    {% for pb in personalBests %}
      {% if pb.maxWeight is not null %}
      <div class="pb-row">
        <div class="pb-name">{{ pb.exerciseName }}</div>
        <div class="pb-vals">
          <span>{{ pb.maxWeight }} kg</span>
          <span style="color:var(--dim)">×{{ pb.maxReps }}</span>
        </div>
      </div>
      {% endif %}
    {% endfor %}
  </div>
  {% endif %}

  {# ── History ── #}
  <div class="card">
    <div class="card-title" style="display:flex;justify-content:space-between;align-items:center">
      <span>Trainingshistorie</span>
      <a href="{{ path('app_log') }}" class="btn btn-ghost btn-sm">+ Neu</a>
    </div>

    {% if sessions is empty %}
      <div style="color:var(--muted);font-size:13px;text-align:center;padding:20px">Noch keine Einträge.</div>
    {% else %}
      <div id="historyList">
        {% for session in sessions %}
          <div class="session-item" id="session-{{ session.id }}">
            <div class="session-dot" style="background:{{ session.typeColor }}"></div>
            <div class="session-body">
              <div class="session-title">{{ session.typeLabel }}</div>
              <div class="session-meta">
                {{ session.date|date('d.m.Y') }}
                {% if session.durationMinutes %} · {{ session.durationMinutes }} Min{% endif %}
                · {{ session.exerciseLogs|length }} Sätze geloggt
              </div>
              {% if session.exerciseLogs is not empty %}
                <div class="session-exercises">
                  {% set seenNames = [] %}
                  {% for log in session.exerciseLogs %}
                    {% if log.exerciseName not in seenNames %}
                      {% set seenNames = seenNames|merge([log.exerciseName]) %}
                      <span class="ex-pill">{{ log.exerciseName }}</span>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}
              {% if session.notes %}
                <div style="font-size:12px;color:var(--muted);margin-top:6px;font-style:italic">{{ session.notes }}</div>
              {% endif %}
            </div>
            <div class="session-actions">
              <button class="btn btn-danger btn-sm" onclick="deleteSession({{ session.id }})">✕</button>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  {% endif %}
</div>
{% endblock %}

{% block scripts %}
<script>
let chart = null;

{% if exerciseNames is not empty %}
function loadChart(name) {
  const canvas = document.getElementById('progressionChart');
  const empty  = document.getElementById('chartEmpty');
  if (!name) { if (chart) chart.destroy(); canvas.style.display='none'; empty.style.display='none'; return; }

  fetch('/api/progression/' + encodeURIComponent(name))
    .then(r => r.json())
    .then(data => {
      if (!data || data.length === 0) {
        if (chart) chart.destroy();
        canvas.style.display = 'none';
        empty.style.display  = 'block';
        return;
      }
      empty.style.display  = 'none';
      canvas.style.display = 'block';

      const labels  = data.map(d => d.date);
      const weights = data.map(d => d.maxWeight);
      const reps    = data.map(d => d.maxReps);

      if (chart) chart.destroy();
      chart = new Chart(canvas, {
        type: 'line',
        data: {
          labels,
          datasets: [
            {
              label: 'Max. Gewicht (kg)',
              data: weights,
              borderColor: '#C9184A',
              backgroundColor: 'rgba(201,24,74,0.08)',
              fill: true,
              tension: 0.3,
              pointBackgroundColor: '#C9184A',
              pointRadius: 4,
              yAxisID: 'yWeight',
            },
            {
              label: 'Max. Wiederholungen',
              data: reps,
              borderColor: '#4361EE',
              backgroundColor: 'rgba(67,97,238,0.06)',
              fill: false,
              tension: 0.3,
              pointBackgroundColor: '#4361EE',
              pointRadius: 4,
              yAxisID: 'yReps',
              borderDash: [4, 3],
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: {
              labels: { color: '#888', font: { family: 'DM Sans', size: 12 }, boxWidth: 12 }
            },
            tooltip: {
              backgroundColor: '#1a1a1a',
              borderColor: 'rgba(255,255,255,0.1)',
              borderWidth: 1,
              titleColor: '#E8E4DE',
              bodyColor: '#888',
            }
          },
          scales: {
            x: {
              ticks: { color: '#555', font: { family: 'Space Mono', size: 10 }, maxTicksLimit: 8 },
              grid:  { color: 'rgba(255,255,255,0.04)' },
            },
            yWeight: {
              position: 'left',
              ticks: { color: '#C9184A', font: { family: 'Space Mono', size: 10 }, callback: v => v + ' kg' },
              grid:  { color: 'rgba(255,255,255,0.04)' },
            },
            yReps: {
              position: 'right',
              ticks: { color: '#4361EE', font: { family: 'Space Mono', size: 10 } },
              grid:  { drawOnChartArea: false },
            }
          }
        }
      });
    })
    .catch(err => console.error(err));
}

// Auto-load first exercise if exists
const firstEx = document.getElementById('exerciseSelect');
if (firstEx && firstEx.options.length > 1) {
  firstEx.selectedIndex = 1;
  loadChart(firstEx.value);
}
{% endif %}

function deleteSession(id) {
  if (!confirm('Training wirklich löschen?')) return;
  fetch('/log/' + id + '/delete', { method: 'DELETE' })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        const el = document.getElementById('session-' + id);
        el.style.opacity = '0';
        el.style.transition = 'opacity 0.3s';
        setTimeout(() => { el.remove(); showToast('Training gelöscht', 'success'); }, 300);
      }
    })
    .catch(() => showToast('Fehler beim Löschen', 'error'));
}
</script>
{% endblock %}
