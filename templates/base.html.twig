<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#0A0A0A">
<title>{% block title %}Trainingsplan – Lukas{% endblock %}</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Mono:wght@700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('css/app.css') }}">
{% block head %}{% endblock %}
</head>
<body>

<nav class="nav">
  <span class="nav-brand">{{ app.user ? app.user.username|upper : 'TRAINING' }}</span>
  {% if app.user %}
    <a href="{{ path('app_plan') }}"      class="nav-link {% if app.request.attributes.get('_route') == 'app_plan' or app.request.attributes.get('_route') == 'app_plan_edit' %}active{% endif %}">{{ 'nav.plan'|trans }}</a>
    <a href="{{ path('app_log') }}"       class="nav-link {% if app.request.attributes.get('_route') starts with 'app_log' %}active{% endif %}">{{ 'nav.log'|trans }}</a>
    <a href="{{ path('app_dashboard') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_dashboard' %}active{% endif %}">{{ 'nav.dashboard'|trans }}</a>
    <a href="{{ path('app_logout') }}"    class="nav-link" style="margin-left:4px;color:var(--muted)">↩</a>
  {% endif %}
    <div class="locale-switcher" id="localeSwitcher">
        <button class="locale-button" type="button" onclick="toggleLocaleMenu()">
            {% if app.request.locale == 'de' %}
                🇩🇪 DE
            {% else %}
                🇬🇧 EN
            {% endif %}
            <span class="chevron">▾</span>
        </button>

        <div class="locale-menu" id="localeMenu">
            <a href="{{ path('app_locale', {locale: 'de'}) }}"
               class="locale-item{% if app.request.locale == 'de' %} active{% endif %}">
                🇩🇪 Deutsch
            </a>

            <a href="{{ path('app_locale', {locale: 'en'}) }}"
               class="locale-item{% if app.request.locale == 'en' %} active{% endif %}">
                🇬🇧 English
            </a>
        </div>
    </div>
</nav>

{% block body %}{% endblock %}

<div class="toast" id="toast"></div>

<script src="{{ asset('js/app.js') }}"></script>
{% block scripts %}{% endblock %}
</body>
</html>
