<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#0A0A0A">
<title>{% block title %}Trainingsplan – Lukas{% endblock %}</title>
    {% block stylesheets %}
        <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Mono:wght@700&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
        <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {% endblock %}
{% block head %}{% endblock %}
</head>
<body>

<nav class="nav">
  <span class="nav-brand">{{ app.user ? app.user.username|upper : 'TRAINING' }}</span>
  {% if app.user %}
    <a href="{{ path('app_plan') }}"      class="nav-link {% if app.request.attributes.get('_route') == 'app_plan' or app.request.attributes.get('_route') == 'app_plan_edit' %}active{% endif %}">Plan</a>
    <a href="{{ path('app_log') }}"       class="nav-link {% if app.request.attributes.get('_route') starts with 'app_log' %}active{% endif %}">Loggen</a>
    <a href="{{ path('app_dashboard') }}" class="nav-link {% if app.request.attributes.get('_route') == 'app_dashboard' %}active{% endif %}">Dashboard</a>
    <a href="{{ path('app_logout') }}"    class="nav-link" style="margin-left:4px;color:var(--muted)">↩</a>
  {% endif %}
</nav>

{% block body %}{% endblock %}

<div class="toast" id="toast"></div>

{{ asset('js/app.js') }}
{% block scripts %}{% endblock %}
</body>
</html>
